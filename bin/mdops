#!/bin/bash
# mdops — the MatterDoor portal. One entry point for humans and agents on this Mac
# to reach rudra (4090 office box) and the ANU Slurm cluster safely.
# Portable to macOS /bin/bash 3.2 (no assoc arrays, no mapfile, no set -u).
# Read AGENTS.md before using this as an agent.
set -o pipefail

ROOT="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")/.." 2>/dev/null && pwd)"
[ -f "$ROOT/AGENTS.md" ] || ROOT="$HOME/matterdoor-ops"
CONF="$ROOT/config/hosts.conf"
STATE="$ROOT/state"
SSHCONF="$HOME/.ssh/config.d/matterdoor.conf"
REMOTE="$ROOT/remote/mdops-remote.sh"
AGENT="${MD_AGENT:-human}"
mkdir -p "$STATE" 2>/dev/null

# ---------- defaults (overridden by config/hosts.conf) ----------
RUDRA_USER=; RUDRA_TS_HOST=; RUDRA_LAN_HOST=; RUDRA_PORT=22; RUDRA_IDENTITIES=
CLUSTER_USER=; CLUSTER_HOST=; CLUSTER_PORT=22; CLUSTER_IDENTITIES=; CLUSTER_ORIG_JUMP=
RUDRA_DATA_ROOT=; RUDRA_ARCHIVE_ROOT=; CLUSTER_WORK_ROOT=; CLUSTER_GROUP_ROOT=
CLUSTER_QUOTA_WARN_PCT=95; CLUSTER_QUOTA_STOP_PCT=100; CLUSTER_MIN_FREE_GB=40
MD_HUB=rudra   # where coordination state lives (locks, journal, handoff, asks): rudra | cluster  (mtd hub use ...)
SLURM_PARTITION=; SLURM_CPU_PARTITION=; SLURM_ACCOUNT=; SLURM_QOS=; SLURM_GRES=gpu:1
CLUSTER_PROJECT_ROOT=; CLUSTER_SUBMIT_GUARD=
WORKSPACE="$HOME/MatterDoor"; WS_REPOS="ANU-Cluster into_the_unknown into_the_unknown_paper"; PROJECT_REPO=into_the_unknown; PAPER_REPO=into_the_unknown_paper
BACKUP_STANDING_APPROVAL=no   # set to yes ONLY by the PI (bootstrap asks): lets agents push code/docs + mirror to rudra
[ -f "$CONF" ] && . "$CONF"
PROJECT_DIR="$WORKSPACE/$PROJECT_REPO"; PAPER_DIR="$WORKSPACE/$PAPER_REPO"; CTRL="$PROJECT_DIR/control"
VERBOSE=0

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
[ -t 1 ] || { c_red=; c_grn=; c_yel=; c_dim=; c_off=; }
say()  { printf '%s\n' "$*"; }
ok()   { printf '%sPASS%s %s\n' "$c_grn" "$c_off" "$*"; }
warn() { printf '%sWARN%s %s\n' "$c_yel" "$c_off" "$*"; }
bad()  { printf '%sFAIL%s %s\n' "$c_red" "$c_off" "$*"; }
die()  { printf '%smdops:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 2; }
pyy() { local p; for p in python3 "$HOME/miniconda3/bin/python" "$HOME/anaconda3/bin/python" "$HOME/miniforge3/bin/python" /usr/bin/python3; do
  command -v "$p" >/dev/null 2>&1 && "$p" -c 'import yaml' 2>/dev/null && { echo "$p"; return 0; }; done; echo python3; }
okl()  { printf 'OK %s\n' "$*"; }                       # compact one-line success
fail() { printf 'FAIL %s\n' "$*"; return 1; }          # compact one-line failure: "<op> <why> -> <fix>"
repo_dir() { local r; for r in $WS_REPOS; do case "$r" in "$1"*) echo "$WORKSPACE/$r"; return 0;; esac; done; [ -d "$1/.git" ] && { echo "$1"; return 0; }; return 1; }
need_conf() { local v; for v in "$@"; do eval "[ -n \"\$$v\" ]" || die "config value $v is not set in $CONF (see docs/storage.md; lead agent sets it after reviewing discovery)"; done; }

# portable timeout (macOS has no timeout(1)): perl alarm
to() { local s=$1; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$s" "$@"; return $?; fi
  if command -v gtimeout >/dev/null 2>&1; then gtimeout "$s" "$@"; return $?; fi
  perl -e 'alarm shift @ARGV; exec @ARGV or exit 127' "$s" "$@"; }

q() { local out= a; for a in "$@"; do out="$out $(printf '%q' "$a")"; done; printf '%s' "${out# }"; }

TS_BIN=
for c in tailscale /Applications/Tailscale.app/Contents/MacOS/Tailscale /usr/local/bin/tailscale /opt/homebrew/bin/tailscale; do
  if command -v "$c" >/dev/null 2>&1; then TS_BIN=$c; break; fi
done

# ---------- routing ----------
# rudra:   md-rudra (Tailscale) -> md-rudra-lan (campus / GlobalProtect)
# cluster: md-cluster (jump via md-rudra) -> md-cluster-lan (jump via md-rudra-lan) -> md-cluster-direct
candidates() { case "$1" in
  rudra)   echo "md-rudra"; [ -n "$RUDRA_LAN_HOST" ] && [ "$RUDRA_LAN_HOST" != "$RUDRA_TS_HOST" ] && echo "md-rudra-lan";;
  cluster) echo "md-cluster"; [ -n "$RUDRA_LAN_HOST" ] && [ "$RUDRA_LAN_HOST" != "$RUDRA_TS_HOST" ] && echo "md-cluster-lan"; echo "md-cluster-direct";;
  *) die "unknown host '$1' (use rudra or cluster)";; esac; }

alive() { # ALIAS -> 0 if usable without any prompt
  ssh -O check "$1" >/dev/null 2>&1 && return 0
  to 25 ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$1" true >/dev/null 2>&1; }

route() { # HOST -> prints working alias (cached 5 min), or fails
  local h=$1 cache="$STATE/route.$1" a t
  [ -f "$SSHCONF" ] || die "no ssh config yet: run 'mdops discover' (or 'mdops sshconfig')"
  if [ -f "$cache" ]; then read -r a t < "$cache"
    if [ -n "$a" ] && [ $(( $(date +%s) - ${t:-0} )) -lt 300 ] && ssh -O check "$a" >/dev/null 2>&1; then echo "$a"; return 0; fi
  fi
  for a in $(candidates "$h"); do
    if alive "$a"; then echo "$a $(date +%s)" > "$cache"; echo "$a"; return 0; fi
  done
  rm -f "$cache"; return 1; }

route_or_die() { route "$1" && return 0
  [ "$1" = rudra ] && [ "$(hub)" = rudra ] && die "rudra unreachable. Cluster-only mode: mtd hub use cluster (moves locks/journal/handoff/asks to the cluster). Diagnose: mtd doctor"
  die "no working route to $1. Try: mtd doctor   (if it needs a password/OTP: mtd login $1 — a human types it)"; }

rssh() { # HOST [ssh args/cmd...]  — no automatic retry (commands may not be idempotent)
  local h=$1 a; shift; a=$(route_or_die "$h") || exit 2; ssh "$a" "$@"; }

rssh_ro() { # HOST CMD — read-only commands: one automatic re-route + retry on connection failure
  local h=$1 rc; shift; rssh "$h" "$@"; rc=$?
  if [ $rc = 255 ]; then rm -f "$STATE/route.$h"; sleep 3; warn "connection to $h dropped; re-routing once"; rssh "$h" "$@"; rc=$?; fi
  return $rc; }

remote_state() { [ "$1" = cluster ] && [ -n "$CLUSTER_WORK_ROOT" ] && printf 'MD_STATE=%s' "$(q "$CLUSTER_WORK_ROOT/mdops-state")" || printf 'MD_STATE=$HOME/mdops-state'; }

hub() { [ "$MD_HUB" = cluster ] && echo cluster || echo rudra; }
hub_state_for() { if [ "$1" = cluster ] && [ -n "$CLUSTER_WORK_ROOT" ]; then printf '%s' "$CLUSTER_WORK_ROOT/mdops-state"; else printf '%s' '~/mdops-state'; fi; }

remote() { # HOST SUBCMD ARGS...  — stream remote/mdops-remote.sh, run it there
  local h=$1; shift; rssh "$h" "env $(remote_state "$h") MD_JOB=$(q "${MD_JOB:-}") bash -s -- $(q "$@")" < "$REMOTE"; }

job_gate() { # JOB KIND -> agents may only launch jobs declared in control/registry/jobs.yaml (GPU ones approved by the PI)
  local job=$1 kind=$2 jf="$CTRL/registry/jobs.yaml" st jk
  [ "$AGENT" = human ] && [ -z "$job" ] && return 0
  [ -f "$jf" ] || { [ "$AGENT" = human ] && return 0; die "no $jf (sync the project repo: mtd sync)"; }
  [ -n "$job" ] || die "agents must name a declared job: --job job:<id> (control/registry/jobs.yaml; add it as status: proposed first)"
  st=$(awk -v id="$job" '/^- id:/{f=($3==id)} f&&/^  status:/{print $2; exit}' "$jf")
  jk=$(awk -v id="$job" '/^- id:/{f=($3==id)} f&&/^  kind:/{print $2; exit}' "$jf")
  [ -n "$st" ] || die "job $job is not declared in control/registry/jobs.yaml"
  [ "$st" = retired ] && die "job $job is retired"
  [ "$kind" = gpu ] && [ "$jk" != gpu ] && die "job $job is declared kind=$jk; this launch uses a GPU (add --no-gpu or declare a gpu job)"
  [ "$jk" = gpu ] && [ "$st" != approved ] && die "GPU job $job is '$st': the PI must approve it (status: approved) before it runs"
  once_gate "$job" "$jf"; }
once_gate() { # JOB JOBS_FILE: a job declared 'once: true' runs a single time (PI approvals are one-time, dec:2026-10-18-approvals-once)
  local job=$1 jf=$2 once jh c; once=$(awk -v id="$job" '/^- id:/{f=($3==id)} f&&/^  once:/{print $2; exit}' "$jf")
  [ "$once" = true ] || return 0
  jh=$(awk -v id="$job" '/^- id:/{f=($3==id)} f&&/^  host:/{print $2; exit}' "$jf")
  c=$(remote_ro "${jh:-cluster}" job-count "$job" 2>/dev/null) || die "cannot confirm that one-time job $job has not already run ($jh unreachable): try again when it is reachable"
  [ "${c%% *}" = 0 ] || die "job $job is one-time and already ran as ${c#* } (PI: approvals are not repeated). Report that run's result (mtd status ${c#* }); a repeat needs a new PI approval"
  return 0; }
remote_ro() { local h=$1; shift; rssh_ro "$h" "env $(remote_state "$h") bash -s -- $(q "$@")" < "$REMOTE"; }

# ---------- login-node guard: agents may only run these on the cluster login node ----------
LOGIN_OK=" squeue sacct sinfo sprio sshare scontrol ls cat head tail stat readlink realpath df quota lfs git cd pwd echo printf hostname whoami id date wc test true mkdir basename dirname "
login_guard() { # CMDSTRING -> 0 if allowed
  local seg w rest t
  t=${1//&&/}; t=${t//2>\/dev\/null/}; t=${t//>\/dev\/null/}
  case "$t" in *'$('*|*'`'*|*'&'*|*'>'*) echo "login-node guard: no command substitution, background jobs or file redirection on the cluster login node" >&2; return 3;; esac
  printf '%s\n' "$1" | tr ';|' '\n\n' | awk '{gsub(/&&/,"\n"); print}' | while IFS= read -r seg; do
    set -- $seg; w=$1; [ -z "$w" ] && continue
    case "$LOGIN_OK" in *" $w "*) ;; *) echo "login-node guard: '$w' is not allowed on the cluster login node. Use: mdops submit SCRIPT (GPU, via the project guard), mdops run cluster --no-gpu ... (CPU job), or do it on rudra." >&2; exit 3;; esac
    shift; rest="$*"
    case "$w" in
      git) case "$rest" in *clone*|*gc*|*fsck*|*lfs\ pull*|*lfs\ fetch*) echo "login-node guard: git $rest is heavy — do it in a job or on rudra" >&2; exit 3;; esac ;;
      lfs) case "$rest" in quota*) ;; *) echo "login-node guard: only 'lfs quota' is allowed" >&2; exit 3;; esac ;;
      cat|head|tail|wc) case "$rest" in *\**) echo "login-node guard: name files explicitly (no globs) for $w" >&2; exit 3;; esac ;;
    esac
  done; }


# ---------- human approval gate: every delete or upload needs the human's explicit OK ----------
# Agents ask in chat first, then pass the human's words: --approved "Subhransu, 18:05: yes, prune those 3 runs"
APPROVED="${MD_APPROVED:-}"
need_approval() { # ACTION-DESCRIPTION
  [ "$AGENT" = human ] && [ -t 0 ] && return 0
  [ -n "$APPROVED" ] || die "'$1' deletes or uploads data: ask the human in chat first, then repeat with --approved \"<their words + time>\""
  remote "$(hub)" journal "$AGENT" "APPROVED by human ($APPROVED): $1" >/dev/null 2>&1 || printf -- '- %s [%s] APPROVED (%s): %s\n' "$(date -u +%FT%TZ)" "$AGENT" "$APPROVED" "$1" >> "$STATE/journal-offline.md"; }

# ---------- commands ----------
cmd_help() { sed -n '/^## Commands/,/^## /p' "$ROOT/AGENTS.md" | sed '$d'; }

cmd_net() {
  local sub=${1:-status}
  [ -n "$TS_BIN" ] || warn "Tailscale CLI not found on this Mac"
  case "$sub" in
    status)
      if [ -n "$TS_BIN" ]; then say "== Tailscale (this Mac)"; to 10 "$TS_BIN" status 2>&1 | head -25; fi
      say "== GlobalProtect (ANU VPN)"
      if [ -d /Applications/GlobalProtect.app ]; then pgrep -fl GlobalProtect >/dev/null && say "installed, running" || say "installed, not running (mdops net vpn)"
      else say "not installed — optional fallback; Tailscale via rudra is the primary path (docs/network.md)"; fi
      say "== default route"; route -n get default 2>/dev/null | grep -E 'interface|gateway' || netstat -rn 2>/dev/null | grep -m2 default ;;
    up)   [ -n "$TS_BIN" ] && "$TS_BIN" up ;;
    down) [ "$2" = --yes ] || die "tailscale down cuts the primary route to rudra; repeat with --yes if the human asked"; "$TS_BIN" down ;;
    netcheck) to 30 "$TS_BIN" netcheck ;;
    ping) to 15 "$TS_BIN" ping -c 3 "${RUDRA_TS_HOST:-rudra}" ;;
    vpn)  [ -d /Applications/GlobalProtect.app ] && open -a GlobalProtect && say "GlobalProtect opened — a human signs in (MFA)" || die "GlobalProtect not installed (see docs/network.md)";;
    *) die "net status|up|down --yes|netcheck|ping|vpn" ;;
  esac; }

cmd_login() { # HOST: open a master interactively (password/OTP typed by the human)
  local h=${1:-cluster} a; [ -t 0 ] || die "login needs a human at a terminal"
  for a in $(candidates "$h"); do
    say "trying $a ..."; if ssh -o ConnectTimeout=12 -fN -o ControlMaster=yes "$a"; then
      ok "master open on $a (reused by every agent for 4h, or until the network drops)"; echo "$a $(date +%s)" > "$STATE/route.$h"; return 0; fi
  done; die "could not log in to $h by any route"; }

cmd_route() { local h; for h in ${1:-rudra cluster}; do printf '%-8s ' "$h"; route "$h" || echo "UNREACHABLE"; done; }

cmd_ssh()  { [ -n "$1" ] || die "mdops ssh rudra|cluster [cmd]"; local h=$1; shift
  if [ "$h" = cluster ] && [ "$AGENT" != human ]; then
    [ $# -gt 0 ] || die "agents get no interactive shell on the cluster login node"
    login_guard "$*" || exit 3
  fi
  rssh "$h" "$@"; }
cmd_open() { # interactive: mosh+tmux to rudra when available (survives Wi-Fi changes/sleep), ssh+tmux otherwise
  local h=${1:-rudra} s=${2:-md} a
  [ "$AGENT" = human ] || die "open is for humans; agents use mdops ssh/run"
  a=$(route_or_die "$h") || exit 2
  if [ "$h" = rudra ] && command -v mosh >/dev/null 2>&1 && ssh "$a" 'command -v mosh-server' >/dev/null 2>&1; then
    exec mosh --ssh="ssh" "$a" -- tmux new-session -A -s "$s"
  fi
  [ "$h" = cluster ] && warn "cluster login node: edit/inspect only — compute goes through Slurm"
  ssh "$a" -t "tmux new-session -A -s $(q "$s") 2>/dev/null || exec \$SHELL -l"; }

cmd_submit() { # cluster/JOB.sh --job ID [--check] [--allow-dirty]: the project's own guard admits it; mdops adds the run record
  local s=$1 mode=--submit job= allow=0 out rc rid jid; shift; need_conf CLUSTER_PROJECT_ROOT CLUSTER_SUBMIT_GUARD
  [ -n "$s" ] || die "mtd submit cluster/SOME_JOB.sh --job job:<id> [--check] [--allow-dirty]"
  while [ $# -gt 0 ]; do case "$1" in --check) mode=--check;; --job) job=$2; shift;; --allow-dirty) allow=1;; *) die "unknown option $1";; esac; shift; done
  job_gate "$job" gpu || exit 2
  if [ $mode = --check ]; then rssh cluster "cd $(q "$CLUSTER_PROJECT_ROOT") && bash $(q "$CLUSTER_SUBMIT_GUARD") --check $(q "$s")"; return; fi
  need_conf CLUSTER_WORK_ROOT; export MD_JOB="$job"
  out=$(remote cluster run-submit "$(basename "$s" .sh)" "$CLUSTER_PROJECT_ROOT" "$s" "$CLUSTER_SUBMIT_GUARD" "$allow" "$AGENT" "$CLUSTER_WORK_ROOT" "$CLUSTER_QUOTA_STOP_PCT:$CLUSTER_MIN_FREE_GB" 2>&1); rc=$?
  printf '%s\n' "$out"
  rid=$(printf '%s' "$out" | sed -n 's/^RUN //p'); jid=$(printf '%s' "$out" | sed -n 's/^job: //p')
  [ $rc = 0 ] && [ -n "$rid" ] && cmd_journal "submitted GPU $s ($job) run $rid slurm $jid" >/dev/null && okl "submit $rid slurm $jid (mtd status $rid; results -> mtd harvest $rid)"
  return $rc; }

cmd_census() { # sizes of the cluster roots, measured inside a Slurm CPU job (never on the login node)
  need_conf CLUSTER_WORK_ROOT
  local CLUSTER_MIN_FREE_GB=2   # tiny output: the cleanup that frees space must never be locked out by the floor
  local roots=${*:-"$CLUSTER_GROUP_ROOT /home/group/rudra-shared"}
  SLURM_GRES=; cmd_run cluster --job job:census --dir "$CLUSTER_WORK_ROOT" --allow-dirty --no-gpu --time 01:00:00 --mem 4G --cpus 2 -- \
    bash -c "for r in $roots; do echo \"== \$r\"; du -sh --apparent-size \"\$r\"/* \"\$r\"/.[!.]* 2>/dev/null | sort -h | tail -60; done; df -h $roots; quota -s 2>/dev/null"; }
cmd_tunnel() { # HOST REMOTE_PORT [LOCAL_PORT]
  local h=$1 rp=$2 lp=${3:-$2} a; [ -n "$rp" ] || die "mdops tunnel rudra|cluster REMOTE_PORT [LOCAL_PORT]"
  a=$(route_or_die "$h") || exit 2
  ssh -O forward -L "$lp:localhost:$rp" "$a" && say "http://localhost:$lp -> $h:$rp (stop: ssh -O cancel -L $lp:localhost:$rp $a)"; }

cmd_lock() {
  local a=${1:-list} name=$2 ttl=120 force=; shift 2 2>/dev/null
  while [ $# -gt 0 ]; do case "$1" in --ttl) ttl=$2; shift;; --force) force=--force;; esac; shift; done
  case "$a" in
    acquire) [ -n "$name" ] || die "lock acquire NAME [--ttl MIN]"; remote "$(hub)" lock acquire "$name" "$AGENT" "$ttl" ;;
    release) [ -n "$name" ] || die "lock release NAME"; remote "$(hub)" lock release "$name" "$AGENT" $force ;;
    *) remote "$(hub)" lock list ;;
  esac; }

cmd_journal() {
  if [ "$1" = --tail ]; then remote "$(hub)" journal-tail "${2:-30}"; return; fi
  [ -n "$*" ] || die 'mdops journal "what you did / what is running"'
  if route "$(hub)" >/dev/null && remote "$(hub)" journal "$AGENT" "$*" 2>/dev/null; then
    [ -s "$STATE/journal-offline.md" ] && rssh "$(hub)" "cat >> $(hub_state_for "$(hub)")/journal.md" < "$STATE/journal-offline.md" && mv "$STATE/journal-offline.md" "$STATE/journal-offline.merged.$(date +%s)"
    return 0; fi
  printf -- '- %s [%s@mac OFFLINE] %s\n' "$(date -u +%FT%TZ)" "$AGENT" "$*" >> "$STATE/journal-offline.md"
  warn "hub $(hub) unreachable — saved to state/journal-offline.md (merged into the hub journal at the next successful journal entry)"; }

cmd_run() { # rudra|cluster --name N --dir D [opts] -- CMD...
  local h=$1; shift; local name= dir= allow=0 gpu=1 gpus=1 time=04:00:00 mem=32G cpus=8 part=$SLURM_PARTITION job=
  while [ $# -gt 0 ] && [ "$1" != -- ]; do case "$1" in
    --job) job=$2; shift;;
    --name) name=$2; shift;; --dir) dir=$2; shift;; --allow-dirty) allow=1;; --no-gpu) gpu=0; gpus=0;;
    --gpus) gpus=$2; shift;; --time) time=$2; shift;; --mem) mem=$2; shift;; --cpus) cpus=$2; shift;; --partition) part=$2; shift;;
    *) die "unknown option $1";; esac; shift; done
  [ "$1" = -- ] && shift
  [ -n "$name" ] || name=${job#job:}
  [ -n "$name" ] && [ -n "$dir" ] && [ $# -gt 0 ] || die "mdops run rudra|cluster --job ID --dir REMOTE_REPO_DIR [--allow-dirty] -- CMD..."
  job_gate "$job" "$([ "$gpu" = 1 ] && echo gpu || echo cpu)" || exit 2
  export MD_JOB="$job"
  case "$h" in
    rudra) remote rudra run-local "$name" "$dir" "$allow" "$gpu" "$AGENT" "$RUDRA_DATA_ROOT" -- "$@" ;;
    cluster)
      need_conf CLUSTER_WORK_ROOT
      if [ "$gpus" -gt 0 ] 2>/dev/null && [ -n "$CLUSTER_SUBMIT_GUARD" ]; then
        die "GPU jobs on this cluster go through the project guard: put the job script in the project's cluster/ dir and run 'mdops submit cluster/JOB.sh' (typed GRES + gpu_job_guard). For CPU work add --no-gpu."
      fi
      if [ "$gpus" -gt 0 ] 2>/dev/null; then case "$SLURM_GRES" in gpu:*:*) ;; *) die "set a typed SLURM_GRES (e.g. gpu:3090:1) in $CONF, or use --no-gpu";; esac
      else part=${SLURM_CPU_PARTITION:-}; fi
      set -- "--nodes=1" "--ntasks=1" "--time=$time" "--mem=$mem" "--cpus-per-task=$cpus" -- "$@"
      [ "$gpus" -gt 0 ] 2>/dev/null && set -- "--gres=${SLURM_GRES%:*}:$gpus" "$@"
      [ -n "$part" ] && set -- "--partition=$part" "$@"
      [ -n "$SLURM_ACCOUNT" ] && set -- "--account=$SLURM_ACCOUNT" "$@"
      [ -n "$SLURM_QOS" ] && set -- "--qos=$SLURM_QOS" "$@"
      remote cluster run-slurm "$name" "$dir" "$allow" "$AGENT" "$CLUSTER_WORK_ROOT" "$CLUSTER_QUOTA_STOP_PCT:$CLUSTER_MIN_FREE_GB" "$@" ;;
    *) die "run rudra|cluster" ;;
  esac; }

cmd_cancel() { # RUN_ID — only runs started under your MD_AGENT (humans: --human)
  local id=$1 h=rudra; [ -n "$id" ] || die "mdops cancel RUN_ID"; case "$id" in *-cluster-*) h=cluster;; esac
  [ "$2" = --human ] && { [ "$AGENT" = human ] && [ -t 0 ] || die "--human is for a person at a terminal"; }
  remote "$h" cancel "$id" "$AGENT" ${2:+"$2"}; }

cmd_runs() { local h; for h in ${1:-rudra cluster}; do say "== $h"; remote "$h" runs "${2:-15}" || warn "$h unreachable"; done; }
cmd_status() { local id=$1; [ -n "$id" ] || { cmd_resources; return; }; case "$id" in *-cluster-*) remote cluster run-status "$id";; *) remote rudra run-status "$id";; esac; }

cmd_quota() {
  [ -n "$CLUSTER_WORK_ROOT" ] && { printf 'cluster work  %s: ' "$CLUSTER_WORK_ROOT"; remote cluster usage "$CLUSTER_WORK_ROOT"; }
  [ -n "$CLUSTER_GROUP_ROOT" ] && { printf 'cluster group %s: ' "$CLUSTER_GROUP_ROOT"; remote cluster usage "$CLUSTER_GROUP_ROOT"; }
  [ -n "$RUDRA_DATA_ROOT" ] && { printf 'rudra data    %s: ' "$RUDRA_DATA_ROOT"; remote rudra usage "$RUDRA_DATA_ROOT"; }
  printf 'rudra home: '; remote rudra usage "~" 2>/dev/null || rssh rudra 'df -h ~ | tail -1'
  say "${c_dim}(pct used, used, limit, source, free) — cluster writes stop below ${CLUSTER_MIN_FREE_GB}G free$([ "$CLUSTER_QUOTA_STOP_PCT" -lt 100 ] && echo " or at ${CLUSTER_QUOTA_STOP_PCT}%")${c_off}"; }

retry_rsync() { # DRYFLAG SRC DST -> shell snippet run ON rudra: resumable, stall-detecting, 5 attempts
  printf 'ok=1; for i in 1 2 3 4 5; do rsync -a --partial --timeout=120 --human-readable --stats %s %s %s && { ok=0; break; }; echo "[mdops] rsync attempt $i failed; retrying in $((i*15))s"; sleep $((i*15)); done; [ $ok = 0 ]' "$1" "$(q "$2")" "$(q "$3")"; }

pct_of() { remote "$1" usage "$2" | awk '{print $1}'; }

cmd_stage() { # PATH [--from rudra|mac] [--name N] [--yes]   -> cluster work/stage/N (default source: rudra)
  local src=$1 name= yes=0 from=rudra; shift
  while [ $# -gt 0 ]; do case "$1" in --name) name=$2; shift;; --yes) yes=1;; --from) from=$2; shift;; esac; shift; done
  need_conf CLUSTER_WORK_ROOT; [ -n "$src" ] || die "mtd stage PATH [--from rudra|mac] [--name NAME] [--yes]"
  name=${name:-$(basename "$src")}
  if [ $yes = 1 ]; then remote cluster storage-gate "$CLUSTER_WORK_ROOT" "$CLUSTER_QUOTA_STOP_PCT:$CLUSTER_MIN_FREE_GB" >/dev/null || exit 2
  else remote cluster storage-gate "$CLUSTER_WORK_ROOT" "$CLUSTER_QUOTA_STOP_PCT:$CLUSTER_MIN_FREE_GB" >/dev/null 2>&1 || warn "the real transfer would be refused now: cluster below the ${CLUSTER_MIN_FREE_GB}G free floor"; fi
  if [ "$from" = mac ]; then
    [ -e "$src" ] || die "no such local path: $src"; local a n=-n i ok=1; a=$(route_or_die cluster) || exit 2
    [ $yes = 1 ] && { need_approval "upload mac:$src -> cluster stage/$name"; n=; }
    say "mac:$src/ -> $a:$CLUSTER_WORK_ROOT/stage/$name/  $( [ $yes = 1 ] && echo REAL || echo 'DRY RUN (add --yes)')  size $(du -sh "$src" | cut -f1)"
    rssh cluster "mkdir -p $(q "$CLUSTER_WORK_ROOT/stage/$name")" || die "cannot create stage dir"
    for i in 1 2 3 4 5; do rsync -a $n "$src/" "$a:$CLUSTER_WORK_ROOT/stage/$name/" && { ok=0; break; }; echo "[mdops] rsync attempt $i failed; retrying"; sleep $((i*15)); done
    [ $ok = 0 ] && okl "stage mac -> cluster $name$( [ $yes = 1 ] || echo ' (dry run)')" || fail "stage failed after 5 attempts"; return $ok
  fi
  route rudra >/dev/null || die "rudra unreachable: stage from this Mac instead (--from mac), e.g. after downloading here"
  local dest="md-cluster:$CLUSTER_WORK_ROOT/stage/$name/" n=-n; [ $yes = 1 ] && { need_approval "upload rudra:$src -> cluster stage/$name"; n=; }
  say "rudra:$src/  ->  $dest   $( [ $yes = 1 ] && echo REAL || echo 'DRY RUN (add --yes)')"
  rssh rudra "du -sh $(q "$src") 2>/dev/null; ssh -o BatchMode=yes md-cluster mkdir -p $(q "$CLUSTER_WORK_ROOT/stage/$name") && $(retry_rsync "$n" "$src/" "$dest")" \
    || die "stage failed (rudra->cluster key missing? run: mdops link-rudra-cluster)"; }

harvest_mac() { # ID YES -> $WORKSPACE/data/runs/ID, verified by file count + bytes
  local id=$1 yes=$2 a dst="$WORKSPACE/data/runs/$1" n=-n i ok=1 rc rl; a=$(route_or_die cluster) || exit 2
  [ $yes = 1 ] && n=; mkdir -p "$dst"
  for i in 1 2 3 4 5; do rsync -a $n "$a:$CLUSTER_WORK_ROOT/runs/$id/" "$dst/" && { ok=0; break; }; sleep $((i*15)); done
  [ $ok = 0 ] || { fail "harvest $id rsync failed"; return 1; }
  [ $yes = 1 ] || { okl "harvest $id to mac (dry run — add --yes)"; return 0; }
  rc=$(rssh cluster "find $(q "$CLUSTER_WORK_ROOT/runs/$id") -type f -printf '%s\n' | awk '{n++; b+=\$1} END{print n+0, b+0}'")
  if [ "$(uname)" = Darwin ]; then rl=$(find "$dst" -type f -exec stat -f %z {} + | awk '{n++; b+=$1} END{print n+0, b+0}')
  else rl=$(find "$dst" -type f -printf '%s\n' | awk '{n++; b+=$1} END{print n+0, b+0}'); fi
  if [ "$rc" = "$rl" ]; then remote cluster mark-harvested "$CLUSTER_WORK_ROOT/runs/$id" >/dev/null; okl "harvest $id -> $dst verified ($rl files/bytes); cluster copy now prunable"
  else fail "harvest $id verify mismatch cluster=[$rc] mac=[$rl]; not marked"; fi; }

cmd_harvest() { # RUN_ID [--to rudra|mac] [--yes]   cluster work/runs/ID -> rudra data root (default) or this Mac; never deletes
  local id=$1 yes=0 to=rudra; shift; while [ $# -gt 0 ]; do case "$1" in --yes) yes=1;; --to) to=$2; shift;; esac; shift; done
  need_conf CLUSTER_WORK_ROOT; [ -n "$id" ] || die "mtd harvest RUN_ID [--to rudra|mac] [--yes]"
  if [ "$to" = mac ] || ! route rudra >/dev/null || [ -z "$RUDRA_DATA_ROOT" ]; then harvest_mac "$id" "$yes"; return; fi
  local src="md-cluster:$CLUSTER_WORK_ROOT/runs/$id/" dst="$RUDRA_DATA_ROOT/runs/$id/" n=-n; [ $yes = 1 ] && n=
  rssh rudra "mkdir -p $(q "$dst") && $(retry_rsync "$n" "$src" "$dst")" || die "harvest failed"
  if [ $yes = 1 ]; then
    local diff; diff=$(rssh rudra "rsync -a -n --itemize-changes $(q "$src") $(q "$dst") | grep -c '^[<>c]'")
    if [ "${diff:-1}" = 0 ]; then remote cluster mark-harvested "$CLUSTER_WORK_ROOT/runs/$id"; ok "harvested + verified; cluster copy now prunable"; else warn "verify found $diff differences; NOT marked harvested"; fi
  else say "(dry run — add --yes)"; fi; }

cmd_prune() { need_conf CLUSTER_WORK_ROOT; [ "$1" = --yes ] && need_approval "delete harvested cluster run dirs"; remote cluster prune "$CLUSTER_WORK_ROOT" "$([ "$1" = --yes ] && echo 1 || echo 0)"; }

cmd_link_rudra_cluster() { # give rudra its own key to the cluster so data moves rudra<->cluster directly
  need_conf CLUSTER_HOST CLUSTER_USER; [ "$1" = --yes ] || die "this adds a rudra-only key to the cluster's ~/.ssh/authorized_keys and a 'md-cluster' entry to rudra's ~/.ssh/config. Repeat with --yes."
  need_approval "create rudra->cluster key and upload it to the cluster"
  local pub
  pub=$(rssh rudra 'set -e; mkdir -p ~/.ssh; chmod 700 ~/.ssh; k=~/.ssh/id_ed25519_mdcluster
    [ -f $k ] || ssh-keygen -q -t ed25519 -N "" -C "rudra->cluster mdops" -f $k; cat $k.pub') || die "could not create key on rudra"
  rssh cluster "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && (grep -qF $(q "$pub") ~/.ssh/authorized_keys || echo $(q "$pub") >> ~/.ssh/authorized_keys)" || die "could not authorise key on cluster"
  local block="Host md-cluster
  HostName $CLUSTER_HOST
  User $CLUSTER_USER
  Port $CLUSTER_PORT
  IdentityFile ~/.ssh/id_ed25519_mdcluster
  IdentitiesOnly yes
  ServerAliveInterval 15
  ServerAliveCountMax 8
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 1h"
  rssh rudra "touch ~/.ssh/config; chmod 600 ~/.ssh/config; grep -q '^Host md-cluster\$' ~/.ssh/config || printf '\n%s\n' $(q "$block") >> ~/.ssh/config; ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new md-cluster true" \
    && ok "rudra -> cluster works without a password" || bad "key installed but rudra still cannot log in (cluster may forbid keys from campus hosts; see docs/runbook.md)"; }

cmd_harden_rudra() {
  [ -t 0 ] || die "harden-rudra needs a human to type the sudo password"
  rssh rudra 'mkdir -p ~/mdops-state/bin && cat > ~/mdops-state/bin/rudra-harden.sh' < "$ROOT/remote/rudra-harden.sh" || die "copy failed"
  rssh rudra -t "sudo bash ~/mdops-state/bin/rudra-harden.sh --cluster-host=$(q "$CLUSTER_HOST") $(q "$@")"; }

cmd_clean() { # scan | caches [--yes]  (rudra only; anything not a cache goes through mdops archive)
  case "${1:-scan}" in
    scan) rssh rudra "env MD_ROLE=rudra bash -s" < "$ROOT/remote/probe.sh" | sed -n '/===== home top-level/,/===== gpu/p' ;;
    caches)
      local n=1; [ "$2" = --yes ] && n=0
      if [ $n = 0 ]; then
        need_approval "delete rudra caches (pip, conda pkgs, trash, thumbnails)"
        [ "$(remote rudra busy)" = 0 ] || die "runs are active on rudra (mdops runs rudra); cache cleanup waits so it cannot disrupt them"
        remote "$(hub)" lock acquire rudra-cleanup "$AGENT" 60 >/dev/null || die "another agent holds rudra-cleanup"
        trap 'remote "$(hub)" lock release rudra-cleanup "$AGENT" >/dev/null' EXIT
      fi
      rssh rudra "n=$n; for d in ~/.cache/pip ~/.local/share/Trash/files ~/.local/share/Trash/info ~/.cache/thumbnails ~/.npm/_cacache; do
          [ -d \"\$d\" ] || continue; printf '%s\t%s\n' \"\$(du -sh \"\$d\" | cut -f1)\" \"\$d\"; [ \$n = 0 ] && rm -rf -- \"\$d\"/* \"\$d\"/.[!.]* 2>/dev/null
        done
        if command -v conda >/dev/null; then if [ \$n = 0 ]; then conda clean -a -y -q; else conda clean -a --dry-run -q 2>/dev/null | tail -3; fi; fi
        echo 'HF/torch model caches older than 30 days (re-downloadable, listed only — remove by hand or ask):'
        find ~/.cache/huggingface/hub -mindepth 1 -maxdepth 1 -atime +30 -exec du -sh {} + 2>/dev/null | sort -h | tail -15
        [ \$n = 1 ] && echo '(dry run — add --yes)'" ;;
    *) die "clean scan | clean caches [--yes]" ;;
  esac; }

cmd_archive() { # RUDRA_PATH [--yes]: tar+zstd into RUDRA_ARCHIVE_ROOT, verify, then (only with --remove-original) delete
  local src=$1 yes=0 rm=0; shift; while [ $# -gt 0 ]; do case "$1" in --yes) yes=1;; --remove-original) rm=1;; esac; shift; done
  need_conf RUDRA_ARCHIVE_ROOT; [ -n "$src" ] || die "mdops archive RUDRA_PATH [--yes] [--remove-original]"
  [ $yes = 1 ] || { rssh rudra "du -sh $(q "$src"); df -h $(q "$RUDRA_ARCHIVE_ROOT") | tail -1"; say "(dry run — add --yes to archive; originals are kept unless --remove-original AND verification passes)"; return; }
  [ $rm = 1 ] && need_approval "archive and then DELETE original rudra:$src"
  remote "$(hub)" lock acquire rudra-cleanup "$AGENT" 240 >/dev/null || die "another agent holds rudra-cleanup"
  trap 'remote "$(hub)" lock release rudra-cleanup "$AGENT" >/dev/null' EXIT
  rssh rudra "set -e; src=\$(readlink -f $(q "$src")); name=\$(basename \"\$src\")-\$(date +%Y%m%d); dst=$(q "$RUDRA_ARCHIVE_ROOT")/\$name.tar.zst
    mkdir -p $(q "$RUDRA_ARCHIVE_ROOT"); cd \"\$(dirname \"\$src\")\"
    tar -cf - \"\$(basename \"\$src\")\" | zstd -T0 -10 -q -o \"\$dst\"
    zstd -t -q \"\$dst\"; n1=\$(find \"\$(basename \"\$src\")\" | wc -l); n2=\$(zstd -dc \"\$dst\" | tar -tf - | wc -l)
    sha256sum \"\$dst\" > \"\$dst.sha256\"; zstd -dc \"\$dst\" | tar -tvf - > \"\$dst.list.txt\"
    echo \"archive \$dst entries src=\$n1 archive=\$n2\"; [ \"\$n1\" = \"\$n2\" ] || { echo 'COUNT MISMATCH — original kept'; exit 3; }
    if [ $rm = 1 ]; then rm -rf -- \"\$src\" && echo \"removed original \$src\"; else echo 'verified; original kept (add --remove-original to delete it)'; fi"; }

cmd_sshconfig() {
  [ -f "$CONF" ] || die "no $CONF — run mdops discover first"
  local rh=${RUDRA_TS_HOST:-$RUDRA_LAN_HOST} i
  [ -n "$rh" ] && [ -n "$CLUSTER_HOST" ] || die "RUDRA_TS_HOST/RUDRA_LAN_HOST and CLUSTER_HOST must be set in $CONF"
  mkdir -p "$HOME/.ssh/config.d" "$HOME/.ssh/cm"; chmod 700 "$HOME/.ssh" "$HOME/.ssh/cm"
  {
    echo "# managed by mdops — regenerate with: mdops sshconfig  (source: $CONF)"
    echo "Host md-rudra"; echo "  HostName $rh"
    if [ -n "$RUDRA_LAN_HOST" ] && [ "$RUDRA_LAN_HOST" != "$rh" ]; then
      echo "Host md-rudra-lan"; echo "  HostName $RUDRA_LAN_HOST"
      echo "Host md-cluster-lan"; echo "  HostName $CLUSTER_HOST"; echo "  ProxyJump md-rudra-lan"
    fi
    echo "Host md-cluster"; echo "  HostName $CLUSTER_HOST"; echo "  ProxyJump md-rudra"
    echo "Host md-cluster-direct"; echo "  HostName $CLUSTER_HOST"; [ -n "$CLUSTER_ORIG_JUMP" ] && echo "  ProxyJump $CLUSTER_ORIG_JUMP"
    echo "Host md-rudra md-rudra-lan"; echo "  HostKeyAlias md-rudra"; [ -n "$RUDRA_USER" ] && echo "  User $RUDRA_USER"; echo "  Port $RUDRA_PORT"
    for i in $RUDRA_IDENTITIES; do echo "  IdentityFile $i"; done
    [ -f "$HOME/.ssh/mdops_agent_ed25519" ] && echo "  IdentityFile ~/.ssh/mdops_agent_ed25519"
    echo "Host md-cluster md-cluster-lan md-cluster-direct"; echo "  HostKeyAlias md-cluster"; [ -n "$CLUSTER_USER" ] && echo "  User $CLUSTER_USER"; echo "  Port $CLUSTER_PORT"
    for i in $CLUSTER_IDENTITIES; do echo "  IdentityFile $i"; done
    [ -f "$HOME/.ssh/mdops_agent_ed25519" ] && echo "  IdentityFile ~/.ssh/mdops_agent_ed25519"
    cat <<'EOF'
Host md-*
  ControlMaster auto
  ControlPath ~/.ssh/cm/%C
  ControlPersist 4h
  ServerAliveInterval 15
  ServerAliveCountMax 8
  ConnectTimeout 12
  ConnectionAttempts 2
  TCPKeepAlive yes
  StrictHostKeyChecking accept-new
  ForwardAgent no
  ForwardX11 no
EOF
  } > "$SSHCONF.tmp"
  chmod 600 "$SSHCONF.tmp"
  if ssh -F "$SSHCONF.tmp" -G md-cluster >/dev/null 2>&1; then mv "$SSHCONF.tmp" "$SSHCONF"; ok "wrote $SSHCONF"
  else rm -f "$SSHCONF.tmp"; die "generated ssh config failed to parse; nothing changed"; fi
  grep -qF "config.d/matterdoor.conf" "$HOME/.ssh/config" 2>/dev/null || warn "~/.ssh/config does not Include config.d/matterdoor.conf (install.sh adds it)"
  rm -f "$STATE"/route.*; }

cmd_doctor() {
  local fails=0 a t0 t1 out
  say "== MatterDoor portal doctor  $(date '+%F %T')  agent=$AGENT"
  [ -f "$CONF" ] && ok "config $CONF" || { bad "no config — run mdops discover"; return 1; }
  [ -f "$SSHCONF" ] && ok "ssh config $SSHCONF" || { bad "no ssh config — mdops sshconfig"; fails=$((fails+1)); }
  if [ -n "$TS_BIN" ] && to 8 "$TS_BIN" status >/dev/null 2>&1; then ok "Tailscale up on this Mac"
    if [ -n "$RUDRA_TS_HOST" ]; then
      to 8 "$TS_BIN" status 2>/dev/null | grep -F "$RUDRA_TS_HOST" | grep -q offline && warn "rudra shows OFFLINE in Tailscale" || ok "rudra listed on the tailnet ($RUDRA_TS_HOST)"
    else warn "rudra is not on Tailscale yet (docs/network.md step 1)"; fi
  else warn "Tailscale not running on this Mac (mdops net up)"; fi
  if [ "$(uname)" = Darwin ]; then pgrep -fq 'caffeinate -i -s' && ok "Mac kept awake" || warn "Mac may sleep (mtd awake on)"
    launchctl list 2>/dev/null | grep -q au.anu.mdops.keepalive && ok "keepalive + Tailscale watchdog running" || warn "keepalive not running (mtd keepalive install)"; fi
  for h in rudra cluster; do
    t0=$(date +%s); a=$(route "$h"); t1=$(date +%s)
    if [ -n "$a" ]; then ok "$h reachable via $a ($((t1-t0))s to pick route)"
      [ "$a" = md-rudra ] || [ "$a" = md-cluster ] || warn "$h is on a fallback route ($a)"
    elif [ "$h" = rudra ] && [ "$(hub)" = cluster ]; then warn "rudra offline — cluster-only mode (hub=cluster); rudra steps wait until it returns"
    else bad "$h unreachable by any route — if it needs a password/OTP a human runs: mdops login $h$([ "$h" = rudra ] && echo '; or work without rudra: mtd hub use cluster')"; fails=$((fails+1)); fi
  done
  if route rudra >/dev/null; then
    out=$(rssh rudra 'nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv,noheader 2>/dev/null; echo "tmux_md=$(tmux ls 2>/dev/null | grep -c "^md-")"; df -h ~ | awk "NR==2{print \"home_free=\"\$4\" (\"\$5\" used)\"}"; ssh -O check md-cluster 2>/dev/null; ssh -o BatchMode=yes -o ConnectTimeout=8 md-cluster true 2>/dev/null && echo rudra_to_cluster=ok || echo rudra_to_cluster=missing; systemctl is-active mdops-netwatch.timer 2>/dev/null | sed "s/^/netwatch=/"; systemctl is-enabled sleep.target 2>/dev/null | sed "s/^/sleep=/"' 2>/dev/null)
    say "${c_dim}$(printf '%s\n' "$out" | sed 's/^/  rudra: /')${c_off}"
    printf '%s' "$out" | grep -q 'rudra_to_cluster=ok' && ok "rudra -> cluster direct key" || warn "rudra -> cluster key missing (mdops link-rudra-cluster --yes) — needed for stage/harvest"
    printf '%s' "$out" | grep -q 'sleep=masked' && ok "rudra cannot sleep" || warn "rudra can still sleep/suspend (mdops harden-rudra)"
    printf '%s' "$out" | grep -q 'netwatch=active' && ok "rudra network watchdog active" || warn "rudra network watchdog not installed (mdops harden-rudra)"
    remote "$(hub)" lock list 2>/dev/null | sed 's/^/  lock: /'
  fi
  if [ -n "$CLUSTER_WORK_ROOT" ] && route cluster >/dev/null; then
    local u p fr; u=$(remote cluster usage "$CLUSTER_WORK_ROOT" 2>/dev/null); p=${u%% *}; fr=$(printf '%s' "$u" | sed -n 's/.*free=\([0-9]*\)G.*/\1/p')
    if [ -z "$p" ] || [ -z "$fr" ]; then warn "cluster usage unknown ($u) — mtd setup creates the work root"
    elif [ "$fr" -lt "$CLUSTER_MIN_FREE_GB" ] || { [ "$CLUSTER_QUOTA_STOP_PCT" -lt 100 ] && [ "$p" -ge "$CLUSTER_QUOTA_STOP_PCT" ]; }; then bad "cluster storage $u — writes blocked (floor ${CLUSTER_MIN_FREE_GB}G free) -> mtd census, then archive/prune with approval"; fails=$((fails+1))
    elif [ "$p" -ge "$CLUSTER_QUOTA_WARN_PCT" ]; then warn "cluster storage $u — $((fr - CLUSTER_MIN_FREE_GB))G usable before writes stop"; else ok "cluster storage $u"; fi
    rssh cluster 'squeue -u $USER -h -o "%i %j %T %M" 2>/dev/null | head' | sed 's/^/  job: /'
  elif [ -z "$CLUSTER_WORK_ROOT" ]; then warn "CLUSTER_WORK_ROOT not set yet (storage plan pending — docs/storage.md)"; fi
  [ -f "$STATE/journal-offline.md" ] && warn "offline journal entries waiting in state/journal-offline.md"
  [ $fails = 0 ] && say "${c_grn}doctor: OK${c_off}" || say "${c_red}doctor: $fails failure(s)${c_off}"
  return $fails; }


cmd_keepalive() { # install | uninstall | status | tick  — macOS launchd agent keeping the rudra (and cluster) masters open
  local plist="$HOME/Library/LaunchAgents/au.anu.mdops.keepalive.plist" log="$STATE/keepalive.log" a
  case "${1:-status}" in
    tick)
      # 1. this Mac's Tailscale: start the app if it quit, bring the tunnel up if it stopped
      if [ "$(uname)" = Darwin ] && [ -d /Applications/Tailscale.app ] && ! pgrep -xq Tailscale; then open -ga Tailscale && echo "$(date '+%F %T') started Tailscale app" >> "$log"; sleep 5; fi
      if [ -n "$TS_BIN" ]; then
        tst=$("$TS_BIN" status --json 2>/dev/null | tr -d ' \n' | grep -o '"BackendState":"[A-Za-z]*"' | head -1 | cut -d'"' -f4)
        case "$tst" in Running|"") ;; Stopped) "$TS_BIN" up >/dev/null 2>&1 && echo "$(date '+%F %T') tailscale up (was Stopped)" >> "$log";;
          *) echo "$(date '+%F %T') tailscale state $tst (NeedsLogin = the PI signs in from the menu bar)" >> "$log";; esac
      fi
      # 2. reopen dropped ssh masters
      for a in md-rudra md-cluster; do
        ssh -O check "$a" >/dev/null 2>&1 && continue
        if to 40 ssh -n -o BatchMode=yes -o ConnectTimeout=12 -fN "$a" >/dev/null 2>&1; then echo "$(date '+%F %T') reopened $a" >> "$log"
        else echo "$(date '+%F %T') $a down (no route or needs a human login)" >> "$log"; fi
      done
      [ -f "$log" ] && [ "$(wc -l < "$log")" -gt 2000 ] && tail -n 500 "$log" > "$log.tmp" && mv "$log.tmp" "$log" ;;
    install)
      mkdir -p "$HOME/Library/LaunchAgents"
      cat > "$plist" <<EOF2
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>au.anu.mdops.keepalive</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$ROOT/bin/mdops</string><string>keepalive</string><string>tick</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>$STATE/keepalive.err</string>
</dict></plist>
EOF2
      launchctl unload "$plist" 2>/dev/null; launchctl load -w "$plist" && ok "keepalive installed: re-opens md-rudra / md-cluster within 60s of a drop (log: state/keepalive.log)" ;;
    uninstall) launchctl unload -w "$plist" 2>/dev/null; rm -f "$plist"; ok "keepalive removed" ;;
    *) [ -f "$plist" ] && launchctl list 2>/dev/null | grep -q au.anu.mdops.keepalive && ok "keepalive running" || warn "keepalive not installed (mdops keepalive install)"
       tail -n 5 "$log" 2>/dev/null ;;
  esac; }


cmd_profile() { # apply FILE: merge KEY=VALUE lines into config/hosts.conf (backup kept)
  [ "$1" = apply ] && [ -f "$2" ] || die "mdops profile apply FILE"
  [ -f "$CONF" ] || die "run mdops discover first"
  cp "$CONF" "$CONF.bak.$(date +%Y%m%d-%H%M%S)"
  local k line
  grep -E '^[A-Z_][A-Z0-9_]*=' "$2" | while IFS= read -r line; do
    k=${line%%=*}
    if grep -q "^$k=" "$CONF"; then awk -v k="$k" -v l="$line" 'index($0,k"=")==1{print l; next}{print}' "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
    else echo "$line" >> "$CONF"; fi
    echo "set $line"
  done
  . "$CONF"; cmd_sshconfig; }


# ---------- agent key: lets sandboxed agents (no access to your ~/.ssh) reach rudra + cluster ----------
cmd_agent_key() {
  local k="$STATE/agent/id_ed25519" pub
  case "${1:-status}" in
    init) mkdir -p "$STATE/agent"; chmod 700 "$STATE/agent"
          [ -f "$k" ] || ssh-keygen -q -t ed25519 -N "" -C "mdops-agent:$(hostname -s 2>/dev/null || hostname):$(date +%Y%m%d)" -f "$k"
          ok "agent key: $k.pub" ;;
    authorize)
      [ "$2" = --yes ] || die "adds the agent key to rudra (jump to the cluster only) and the cluster (no forwarding). Repeat with --yes."
      need_approval "upload agent public key to rudra + cluster authorized_keys"
      [ -f "$k.pub" ] || cmd_agent_key init; pub=$(cat "$k.pub"); need_conf CLUSTER_HOST
      if route rudra >/dev/null; then
      rssh rudra "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && (grep -qF $(q "$pub") ~/.ssh/authorized_keys || echo $(q "no-agent-forwarding,no-X11-forwarding,permitopen=\"$CLUSTER_HOST:$CLUSTER_PORT\" $pub") >> ~/.ssh/authorized_keys)" && ok "agent key authorised on rudra (may only jump to $CLUSTER_HOST)"
      else warn "agent key: rudra offline — authorise there later (mtd setup)"; fi
      rssh cluster "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && (grep -qF $(q "$pub") ~/.ssh/authorized_keys || echo $(q "no-agent-forwarding,no-X11-forwarding,no-port-forwarding $pub") >> ~/.ssh/authorized_keys)" && ok "agent key authorised on cluster (no forwarding)" ;;
    use) [ -f "$k" ] || die "no agent key in $STATE/agent (run on the Mac: mdops agent-key init && mdops agent-key authorize --yes)"
         mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"; cp "$k" "$HOME/.ssh/mdops_agent_ed25519"; chmod 600 "$HOME/.ssh/mdops_agent_ed25519"
         grep -qF "config.d/matterdoor.conf" "$HOME/.ssh/config" 2>/dev/null || { touch "$HOME/.ssh/config"; printf 'Include ~/.ssh/config.d/matterdoor.conf\n%s\n' "$(cat "$HOME/.ssh/config")" > "$HOME/.ssh/config"; chmod 600 "$HOME/.ssh/config"; }
         cmd_sshconfig ;;
    revoke) [ "$2" = --yes ] || die "removes the agent key from rudra and the cluster. Repeat with --yes."
         need_approval "delete agent key from rudra + cluster authorized_keys"; pub=$(cut -d' ' -f2 "$k.pub")
         for h in rudra cluster; do rssh "$h" "f=~/.ssh/authorized_keys; [ -f \$f ] && grep -vF $(q "$pub") \$f > \$f.tmp; mv \$f.tmp \$f && chmod 600 \$f" && ok "revoked on $h"; done ;;
    *) [ -f "$k.pub" ] && say "agent key: $(cut -d' ' -f3 "$k.pub")" || say "no agent key (mdops agent-key init)"; [ -f "$HOME/.ssh/mdops_agent_ed25519" ] && say "in use by this environment" ;;
  esac; }

# ---------- living handoff (canonical copy versioned on rudra; cached here) ----------
HOFF="$STATE/handoff"
ho_fetch() { # -> writes $HOFF/HANDOFF.md + $HOFF/.base ; returns 1 if offline (cache kept)
  local tmp; mkdir -p "$HOFF"; tmp="$HOFF/.fetch.$$"
  if remote_ro "$(hub)" handoff-get > "$tmp" 2>/dev/null; then
    if head -1 "$tmp" | grep -q '^@@NONE@@'; then rm -f "$tmp"; echo none > "$HOFF/.base"; return 2; fi
    head -1 "$tmp" | awk '{print $2, $3}' > "$HOFF/.base"; tail -n +2 "$tmp" > "$HOFF/HANDOFF.md"; rm -f "$tmp"; return 0
  fi; rm -f "$tmp"; return 1; }

ho_put() { # BASE SUMMARY FILE -> upload, then commit on rudra if BASE is still current
  local inc=".incoming-$(printf '%s' "$AGENT" | tr -c 'A-Za-z0-9._-' _)"
  local sp; sp=$(hub_state_for "$(hub)")
  rssh "$(hub)" "mkdir -p $sp/handoff && cat > $sp/handoff/$inc" < "$3" || return 1
  remote "$(hub)" handoff-put "$AGENT" "$1" "$2" "$inc"; }

cmd_handoff() {
  local base ver
  case "${1:-show}" in
    show) ho_fetch; case $? in 1) warn "hub $(hub) unreachable — showing cached handoff";; 2) say "(no handoff yet: mtd handoff init)"; return;; esac
          cat "$HOFF/HANDOFF.md" 2>/dev/null ;;
    init) ho_fetch; [ $? = 2 ] || die "a handoff already exists (or hub $(hub) is unreachable)"
          if [ -f "$CTRL/handoff/HANDOFF.md" ]; then cp "$CTRL/handoff/HANDOFF.md" "$HOFF/HANDOFF.md"   # project seed / mirror
          else sed "s/^_Single source/_Created $(date '+%Y-%m-%d %H:%M') by $AGENT. Single source/" "$ROOT/templates/HANDOFF.template.md" > "$HOFF/HANDOFF.md"; fi
          echo none > "$HOFF/.base"; ho_put none "initial handoff" "$HOFF/HANDOFF.md" ;;
    pull) remote "$(hub)" lock acquire handoff "$AGENT" "${2:-90}" || die "someone else is editing the handoff (see: mdops lock list)"
          ho_fetch; case $? in 0) ;; 2) remote "$(hub)" lock release handoff "$AGENT" >/dev/null; die "no handoff yet: mtd handoff init";; *) remote "$(hub)" lock release handoff "$AGENT" >/dev/null; die "could not fetch the handoff from hub $(hub) (mtd hub status)";; esac
          say "Edit: $HOFF/HANDOFF.md   (base $(cat "$HOFF/.base"))"
          say "Then: mtd handoff push \"one-line summary of this session\"   (or: mtd handoff release)" ;;
    push) [ -n "$2" ] || die 'mtd handoff push "one-line summary"'; [ -f "$HOFF/.base" ] || die "pull first: mtd handoff pull"
          base=$(awk '{print $1}' "$HOFF/.base")
          awk -v line="- $(date '+%Y-%m-%d %H:%M') [$AGENT] $2" '{print} /^## Session log/{getline; print; print line; next}' "$HOFF/HANDOFF.md" > "$HOFF/.new" 2>/dev/null
          grep -qF "[$AGENT] $2" "$HOFF/.new" || { cp "$HOFF/HANDOFF.md" "$HOFF/.new"; printf -- '- %s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M')" "$AGENT" "$2" >> "$HOFF/.new"; }
          ver=$(ho_put "$base" "$2" "$HOFF/.new") || die "push refused (see message above); your edit is still in $HOFF/HANDOFF.md"
          mv "$HOFF/.new" "$HOFF/HANDOFF.md"; ho_fetch >/dev/null; remote "$(hub)" lock release handoff "$AGENT" >/dev/null
          if [ -d "$CTRL/handoff" ]; then cp "$HOFF/HANDOFF.md" "$CTRL/handoff/HANDOFF.md"
            git -C "$PROJECT_DIR" add control/handoff/HANDOFF.md 2>/dev/null && git -C "$PROJECT_DIR" commit -q --only control/handoff/HANDOFF.md -m "handoff: $2" -m "Agent: $AGENT" >/dev/null 2>&1 || true; fi
          okl "handoff $ver (mirrored to control/handoff, committed locally)" ;;
    release) remote "$(hub)" lock release handoff "$AGENT" ;;
    log) remote_ro "$(hub)" handoff-log "${2:-20}" ;;
    *) die "mtd handoff show|pull|push \"summary\"|release|log|init" ;;
  esac; }

# ---------- the briefing: first thing every agent runs (`mtd`) ----------
epoch_of() { date -j -f %Y-%m-%d "$1" +%s 2>/dev/null || date -d "$1" +%s 2>/dev/null; }
cmd_brief() {
  local now d label e days
  now=$(date +%s)
  say "# MTD BRIEFING  —  read all of this before acting"
  say "_$(date '+%a %d %b %Y %H:%M %Z') · host $(hostname -s 2>/dev/null || hostname) · agent=$AGENT · portal $(git -C "$ROOT" log -1 --format=%h 2>/dev/null)_"
  say; say "## 0. Clock"
  for d in ${MTD_DEADLINES:-2026-11-16\|CVPR_2027_paper_submission_AoE 2026-11-23\|CVPR_2027_supplementary_AoE}; do
    e=$(epoch_of "${d%%|*}"); [ -n "$e" ] || continue; days=$(( (e - now) / 86400 )); label=${d#*|}
    say "- ${label//_/ }: ${d%%|*}  →  $days days left"
  done
  local short=0 mode; [ "$1" = --short ] && short=1
  if [ "$(hub)" = cluster ]; then mode="CLUSTER-ONLY (hub=cluster): rudra steps wait; downloads on the Mac + mtd stage --from mac; GPU via mtd submit; mtd harvest --to mac; back with: mtd hub use rudra"
  elif route rudra >/dev/null; then mode="normal (hub=rudra)"; else mode="rudra UNREACHABLE while hub=rudra -> mtd doctor; if it lasts: mtd hub use cluster"; fi
  say "- mode: $mode"
  if [ -f "$CTRL/MISSION.md" ]; then
    say; say "## M. Mission ($CTRL/MISSION.md)"; [ $short = 1 ] && sed -n '/^## Mission/,/^## Deadlines/p' "$CTRL/MISSION.md" | sed -n '2,3p' || cat "$CTRL/MISSION.md"
    say; say "## G. Goals (control/registry/goals.yaml)"
    awk '/^- id:/{id=$3} /^  title:/{sub(/^  title: /,""); t=$0} /^  status:/{st=$2} /^  due:/{printf "- %-26s %-11s due %s  %s\n", id, st, $2, t}' "$CTRL/registry/goals.yaml"
    say; say "## S. Research status (control/STATUS.md)"; [ $short = 1 ] && sed -n '/^## Red flags/,/^## Reviewer gaps/p' "$CTRL/STATUS.md" | grep -E '^[0-9]+\. ' | cut -c1-110 || cat "$CTRL/STATUS.md"
    say; say "## K. Knowledge graph"; "$(pyy)" "$CTRL/tools/kg_check.py" 2>&1 | head -$([ $short = 1 ] && echo 1 || echo 6)
  else say; say "## M. (no control plane found at $CTRL — run: mtd sync, or check WORKSPACE in $CONF)"; fi
  say; say "## A. Open asks (things agents could not access)"; remote_ro "$(hub)" ask-list 2>/dev/null | sed 's/^/    /' || say "    (hub $(hub) unreachable)"
  if [ $short = 1 ]; then
    say; say "## H. Handoff: next steps"; ho_fetch >/dev/null 2>&1; sed -n '/^## Next steps/,/^## Session log/p' "$HOFF/HANDOFF.md" 2>/dev/null | grep -E '^[0-9]+\. ' | cut -c1-140
    say; say "## L. Levers: mtd check | sync [cluster] | save REPO msg [paths] | push REPO --approved | backup | build paper | status | ask | submit | harvest | hub | handoff pull/push  (all one-line, self-verifying)"
    return 0; fi
  say; say "## 1. Non-negotiable rules (full text: $ROOT/AGENTS.md; project rules: CLUSTER_PROJECT_ROOT/AGENTS.md)"
  sed -n '/^## 2\. /,/^## 3\. /p' "$ROOT/AGENTS.md" | sed '1d;$d'
  say; say "## 2. Live state"
  if to 90 "$0" doctor > "$STATE/last-doctor.txt" 2>&1; then :; fi
  sed 's/\x1b\[[0-9;]*m//g' "$STATE/last-doctor.txt" | grep -vE '^== MatterDoor portal doctor' | sed 's/^/    /'
  say; say "## 3. Running work + locks"
  { remote_ro rudra runs 8; remote_ro cluster runs 8; } 2>/dev/null | sed 's/^/    /' || say "    (unreachable)"
  say; say "## 4. Recent journal (all agents)"
  remote_ro "$(hub)" journal-tail 15 2>/dev/null | sed 's/^/    /' || { say "    (hub $(hub) unreachable; offline entries:)"; tail -n 10 "$STATE/journal-offline.md" 2>/dev/null; }
  say; say "## 5. Living handoff"
  ho_fetch; case $? in
    0) say "_version $(awk '{print $2}' "$HOFF/.base") on hub $(hub)_"; cat "$HOFF/HANDOFF.md";;
    1) say "_hub $(hub) unreachable — CACHED copy, may be stale_"; cat "$HOFF/HANDOFF.md" 2>/dev/null;;
    2) say "(none yet — create it: mtd handoff init)";;
  esac
  say; say "## 6. Your session protocol"
  say "1. export MD_AGENT=<tool>-<task>   (now: $AGENT)"
  say "2. Take a lock for shared work (mtd lock acquire NAME --ttl MIN); journal milestones (mtd journal \"...\")."
  say "3. Long work only via mtd run / mtd submit; data only via stage/harvest; never compute on the cluster login node."
  say "4. END OF SESSION (mandatory): mtd handoff pull → edit state/handoff/HANDOFF.md in place (state, runs, ledger, decisions, next steps) → mtd handoff push \"summary\"."
  say; say "## 7. Levers (one line each, self-verifying; read the operating manual: $WORKSPACE/AGENTS.md)"
  [ -f "$CTRL/README.md" ] && sed -n '/^## Levers/,$p' "$CTRL/README.md" | sed '1,4d'
  say; say "## 8. Where things are"
  say "- portal: $ROOT  (docs/network.md, docs/storage.md, docs/runbook.md)"
  say "- config: $CONF   discovery: $STATE/discovery/latest/"
  say "- cluster project checkout: ${CLUSTER_PROJECT_ROOT:-unset}   work root: ${CLUSTER_WORK_ROOT:-unset}   group: ${CLUSTER_GROUP_ROOT:-unset}"
  say "- rudra data: ${RUDRA_DATA_ROOT:-unset}   archive: ${RUDRA_ARCHIVE_ROOT:-unset}"
  say "- commands: mtd help"; }

cmd_agent() { # claude|codex [task...] — start an agent CLI in the portal with the briefing as its first input
  local tool=${1:-claude}; shift 2>/dev/null; command -v "$tool" >/dev/null || die "$tool CLI not installed on this machine"
  export MD_AGENT="${MD_AGENT:-$tool-$(date +%m%d%H%M)}"
  cmd_brief > "$STATE/BRIEF.md" 2>&1
  cd "$ROOT" && exec "$tool" "You are $MD_AGENT. First read $STATE/BRIEF.md completely (rules, live state, living handoff). Then: ${*:-continue from 'Next steps' #1 in the handoff}. At the end of the session update the handoff with mtd handoff pull/push."; }


# ======================================================================
# LEVERS: one command, one line of output, self-verifying. (-v = verbose)
# ======================================================================
cmd_check() { # registry + guard + routes + asks, one line each
  local rc=0 l
  if [ -f "$CTRL/tools/kg_check.py" ]; then l=$("$(pyy)" "$CTRL/tools/kg_check.py" 2>&1); echo "$l" | head -1; case "$l" in FAIL*) rc=1; [ $VERBOSE = 1 ] && echo "$l";; esac
  else fail "kg no control plane at $CTRL -> mtd sync"; rc=1; fi
  if [ -d "$PROJECT_DIR/.git" ]; then l=$(cd "$PROJECT_DIR" && python3 control/tools/repo_guard.py --staged 2>&1); echo "$l" | head -1; case "$l" in FAIL*) rc=1;; esac
    [ "$(git -C "$PROJECT_DIR" config core.hooksPath)" = control/hooks ] && okl "hooks active" || { fail "hooks not active -> git -C $PROJECT_DIR config core.hooksPath control/hooks"; rc=1; }; fi
  local h a; for h in rudra cluster; do a=$(route "$h") && okl "route $h $a" || { if [ "$h" = rudra ] && [ "$(hub)" = cluster ]; then echo "WARN route rudra offline (cluster-only mode)"; else fail "route $h unreachable -> mtd doctor$([ "$h" = rudra ] && echo ' (or: mtd hub use cluster)')"; rc=1; fi; }; done
  route "$(hub)" >/dev/null && okl "hub $(hub)" || { fail "hub $(hub) unreachable -> mtd hub use $([ "$(hub)" = rudra ] && echo cluster || echo rudra)"; rc=1; }
  l=$(remote_ro "$(hub)" ask-list 2>/dev/null | grep -c '^#'); [ "${l:-0}" -gt 0 ] && echo "WARN asks $l open (mtd ask --list)" || okl "asks 0 open"
  return $rc; }

sync_cluster() { # fast-forward the cluster's project checkout (job scripts are submitted from there); never switches branch
  need_conf CLUSTER_PROJECT_ROOT; local o
  o=$(rssh cluster "cd $(q "$CLUSTER_PROJECT_ROOT") || exit 3; b=\$(git rev-parse --abbrev-ref HEAD); d=\$(git status --porcelain --untracked-files=no | wc -l)
    timeout 60 git fetch -q origin \"\$b\" 2>/dev/null || { echo \"FAIL fetch \$b\"; exit 1; }
    set -- \$(git rev-list --left-right --count HEAD...FETCH_HEAD); echo \"branch=\$b head=\$(git rev-parse --short HEAD) dirty=\$d ahead=\$1 behind=\$2\"
    if [ \"\$2\" -gt 0 ] && [ \"\$1\" = 0 ] && [ \"\$d\" = 0 ]; then git merge -q --ff-only FETCH_HEAD && echo \"ff=\$(git rev-parse --short HEAD)\"; fi" 2>&1)
  case "$o" in *"ff="*) okl "sync cluster checkout $(printf '%s' "$o" | tr '\n' ' ')";;
    *"behind=0"*) okl "sync cluster checkout up to date: $(printf '%s' "$o" | tr '\n' ' ')";;
    *branch=*) fail "sync cluster checkout not fast-forwarded: $(printf '%s' "$o" | tr '\n' ' ') -> dirty or diverged: ask the PI (never reset it)"; return 1;;
    *) fail "sync cluster checkout: ${o:-unreachable} -> mtd doctor (the login node may lack GitHub access: mtd ask)"; return 1;; esac; }

cmd_sync() { # fetch + fast-forward every workspace repo; never merges, never discards
  [ "$1" = cluster ] && { sync_cluster; return; }
  local r d b up ahead behind dirty rc=0
  for r in $WS_REPOS; do d="$WORKSPACE/$r"; [ -d "$d/.git" ] || { fail "sync $r missing -> rerun bootstrap"; rc=1; continue; }
    to 120 git -C "$d" fetch -q --prune origin 2>/dev/null || { fail "sync $r fetch failed (network/auth) -> retry later or mtd ask"; rc=1; continue; }
    b=$(git -C "$d" rev-parse --abbrev-ref HEAD); up=$(git -C "$d" rev-parse --abbrev-ref '@{u}' 2>/dev/null)
    dirty=$(git -C "$d" status --porcelain --untracked-files=no | wc -l | tr -d ' ')
    if [ -z "$up" ]; then okl "sync $r $b $(git -C "$d" rev-parse --short HEAD) (no upstream; local branch) dirty=$dirty"; continue; fi
    set -- $(git -C "$d" rev-list --left-right --count HEAD...'@{u}'); ahead=$1; behind=$2
    if [ "$behind" -gt 0 ] && [ "$ahead" = 0 ]; then
      git -C "$d" merge -q --ff-only '@{u}' 2>/dev/null || { fail "sync $r cannot fast-forward (local edits overlap) -> commit with mtd save, then mtd sync"; rc=1; continue; }
    elif [ "$behind" -gt 0 ]; then fail "sync $r diverged (ahead $ahead, behind $behind) -> git -C $d rebase @{u} (resolve) or ask the PI"; rc=1; continue; fi
    [ "$(git -C "$d" rev-list --count '@{u}..HEAD')" = "$ahead" ] && okl "sync $r $b $(git -C "$d" rev-parse --short HEAD) ahead=$ahead behind=0 dirty=$dirty"
  done
  # the workspace manual is a generated copy of the portal templates: keep it current (a local edit is backed up, never lost)
  local f n=0 bk="$WORKSPACE/scratch/manual-backups"
  for f in START_HERE.md AGENTS.md README.md CLAUDE.md; do [ -f "$ROOT/templates/workspace/$f" ] || continue
    cmp -s "$ROOT/templates/workspace/$f" "$WORKSPACE/$f" && continue
    [ -f "$WORKSPACE/$f" ] && { mkdir -p "$bk"; cp "$WORKSPACE/$f" "$bk/$f.$(date +%Y%m%d-%H%M%S)"; }
    cp "$ROOT/templates/workspace/$f" "$WORKSPACE/$f" && n=$((n+1)); done
  [ $n -gt 0 ] && okl "sync workspace manual refreshed ($n file(s); previous copies in scratch/manual-backups)"
  return $rc; }

cmd_save() { # REPO "message" [paths...]: commit locally (hooks enforce guards). No paths = tracked changes only.
  local d msg before n; d=$(repo_dir "$1") || die "save: unknown repo '$1' (one of: $WS_REPOS)"; msg=$2; shift 2 2>/dev/null
  [ -n "$msg" ] || die 'mtd save REPO "message" [paths...]'
  before=$(git -C "$d" rev-parse HEAD 2>/dev/null)
  if [ $# -gt 0 ]; then git -C "$d" add -- "$@" || { fail "save add failed"; return 1; }; else git -C "$d" add -u; fi
  n=$(git -C "$d" diff --cached --name-only | wc -l | tr -d ' '); [ "$n" -gt 0 ] || { okl "save $(basename "$d") nothing to commit"; return 0; }
  if ! out=$(git -C "$d" commit -q -m "$msg" -m "Agent: $AGENT" 2>&1); then fail "save $(basename "$d") refused: $(echo "$out" | grep -E 'FAIL|error' | head -3 | tr '\n' ' ') -> fix and retry"; return 1; fi
  [ "$(git -C "$d" rev-parse HEAD)" != "$before" ] || { fail "save no new commit"; return 1; }
  if [ $# -gt 0 ] && [ -n "$(git -C "$d" status --porcelain -- "$@")" ]; then fail "save committed but paths still dirty: $*"; return 1; fi
  okl "save $(basename "$d") $(git -C "$d" rev-parse --short HEAD) $n files"; }

push_allowed() { [ "$BACKUP_STANDING_APPROVAL" = yes ] && return 0; need_approval "$1"; }
cmd_push() { # REPO|all: push current branch to GitHub (upload: PI approval or standing approval); verify remote sha
  local r d b sha rs rc=0 list
  [ "$1" = all ] && list=$WS_REPOS || { d=$(repo_dir "$1") || die "push: unknown repo '$1'"; list=$(basename "$d"); }
  push_allowed "push $list to GitHub (code/docs only; data is blocked by guards)" || exit 2
  for r in $list; do d="$WORKSPACE/$r"; [ -d "$d/.git" ] || continue
    b=$(git -C "$d" rev-parse --abbrev-ref HEAD); sha=$(git -C "$d" rev-parse HEAD)
    if ! out=$(to 300 git -C "$d" push -q -u origin "$b" 2>&1); then fail "push $r $b: $(echo "$out" | grep -E 'FAIL|rejected|error|denied' | head -2 | tr '\n' ' ') -> mtd sync, fix, retry"; rc=1; continue; fi
    rs=$(to 60 git -C "$d" ls-remote origin "refs/heads/$b" | cut -f1)
    [ "$rs" = "$sha" ] && okl "push $r $b ${sha:0:7} verified" || { fail "push $r remote $rs != local $sha"; rc=1; }
  done; return $rc; }

wip_snapshot() { # DIR -> prints a commit sha capturing tracked + small untracked work, without touching index/worktree
  local d=$1 tmp f sz files=""; tmp=$(mktemp); git -C "$d" read-tree --index-output="$tmp" HEAD 2>/dev/null || { rm -f "$tmp"; return 1; }
  ( cd "$d" && export GIT_INDEX_FILE="$tmp"
    git add -u 2>/dev/null
    git ls-files --others --exclude-standard | while IFS= read -r f; do
      case "$f" in *.npy|*.npz|*.pt|*.pth|*.ckpt|*.safetensors|*.bin|*.h5|*.hdf5|*.ply|*.glb|*.obj|*.exr|*.tar|*.tar.gz|*.tgz|*.zip|*.7z|*.mp4|*.mkv|data/*|outputs/*) continue;; esac
      sz=$(wc -c < "$f" 2>/dev/null || echo 0); [ "$sz" -lt 20971520 ] && git add -- "$f" 2>/dev/null
    done
    t=$(git write-tree) && [ "$t" != "$(git rev-parse 'HEAD^{tree}')" ] && git commit-tree "$t" -p HEAD -m "WIP snapshot $(date -u +%FT%TZ) by $AGENT on $(hostname -s)" )
  rm -f "$tmp"; }

cmd_backup() { # mirror every repo (all branches + a WIP snapshot ref) to rudra; push branches to GitHub if standing approval
  case "$1" in install|uninstall|status) backup_agent "$1"; return;; esac
  [ "$1" = --auto ] && [ "$BACKUP_STANDING_APPROVAL" != yes ] && { echo "$(date '+%F %T') skipped: no standing approval" >> "$STATE/backup.log"; return 0; }
  push_allowed "back up all workspace repos to rudra mirrors (and GitHub)" || exit 2
  local r d url w ts rc=0 n mirrors=1; ts=$(date -u +%Y%m%dT%H%M%SZ); route rudra >/dev/null || { echo "WARN backup rudra offline: rudra mirrors skipped (GitHub push still runs with standing approval)"; mirrors=0; }
  for r in $WS_REPOS; do d="$WORKSPACE/$r"; [ -d "$d/.git" ] && [ $mirrors = 1 ] || continue
    rssh rudra "mkdir -p ~/mdops-state/mirrors && cd ~/mdops-state/mirrors && { [ -d $r.git ] || git init -q --bare $r.git; }" || { fail "backup $r cannot create mirror"; rc=1; continue; }
    url="$(route rudra):mdops-state/mirrors/$r.git"
    [ "$(git -C "$d" rev-parse --is-shallow-repository)" = true ] && { fail "backup $r is a shallow clone -> git -C $d fetch --unshallow"; rc=1; continue; }
    GIT_LFS_SKIP_PUSH=1 to 600 git -C "$d" push -q "$url" 'refs/heads/*:refs/heads/*' 'refs/tags/*:refs/tags/*' >/dev/null 2>&1 || { fail "backup $r push to rudra failed (guards? run: git -C $d push $url HEAD)"; rc=1; continue; }
    if [ -d "$d/.git/lfs/objects" ] && [ -n "$(ls -A "$d/.git/lfs/objects" 2>/dev/null)" ]; then
      rssh rudra "mkdir -p ~/mdops-state/mirrors/$r.git/lfs/objects" && rsync -a "$d/.git/lfs/objects/" "$(route rudra):mdops-state/mirrors/$r.git/lfs/objects/" >/dev/null 2>&1 || { fail "backup $r LFS objects not copied"; rc=1; }; fi
    w=$(wip_snapshot "$d"); ws=""
    if [ -n "$w" ]; then GIT_LFS_SKIP_PUSH=1 to 300 git -C "$d" push -q "$url" "$w:refs/backups/$(hostname -s)/$ts" >/dev/null 2>&1 && ws=" +wip ${w:0:7}" || ws=" (wip refused by guards: uncommitted frozen/data changes)"; fi
    n=$(git -C "$d" for-each-ref --format='%(objectname) %(refname:short)' refs/heads | while read -r sha ref; do [ "$(git -C "$d" ls-remote "$url" "refs/heads/$ref" | cut -f1)" = "$sha" ] || echo x; done | wc -l | tr -d ' ')
    [ "$n" = 0 ] && okl "backup $r rudra ok$ws" || { fail "backup $r $n branch(es) not verified on rudra"; rc=1; }
  done
  [ "$BACKUP_STANDING_APPROVAL" = yes ] && { cmd_push all || rc=1; }
  echo "$(date '+%F %T') backup rc=$rc" >> "$STATE/backup.log"; return $rc; }

backup_agent() { local plist="$HOME/Library/LaunchAgents/au.anu.mdops.backup.plist"
  case "$1" in
    install) mkdir -p "$HOME/Library/LaunchAgents"; cat > "$plist" <<EOF3
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>au.anu.mdops.backup</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$ROOT/bin/mdops</string><string>backup</string><string>--auto</string></array>
  <key>EnvironmentVariables</key><dict><key>MD_AGENT</key><string>backup-agent</string></dict>
  <key>StartInterval</key><integer>7200</integer>
  <key>StandardErrorPath</key><string>$STATE/backup.err</string>
</dict></plist>
EOF3
      launchctl unload "$plist" 2>/dev/null; launchctl load -w "$plist" && okl "backup agent every 2h (runs only with standing approval)";;
    uninstall) launchctl unload -w "$plist" 2>/dev/null; rm -f "$plist"; okl "backup agent removed";;
    *) [ -f "$plist" ] && okl "backup agent installed; last: $(tail -1 "$STATE/backup.log" 2>/dev/null)" || echo "WARN backup agent not installed (mtd backup install)";;
  esac; }

cmd_build() { # paper: compile; one line with pages, undefined refs/citations, warnings
  [ "${1:-paper}" = paper ] || die "mtd build paper"
  local d="$PAPER_DIR" out="$STATE/build/paper" lm log pages undef warn
  [ -f "$d/main.tex" ] || { fail "build no $d/main.tex -> mtd sync"; return 1; }
  lm=$(command -v latexmk || ls /Library/TeX/texbin/latexmk 2>/dev/null) || { fail "build latexmk not found -> install TeX Live / MacTeX (or mtd ask)"; return 1; }
  mkdir -p "$out"; ( cd "$d" && to 600 "$lm" -pdf -interaction=nonstopmode -halt-on-error -outdir="$out" main.tex >/dev/null 2>&1 ); log="$out/main.log"
  pages=$(grep -o 'Output written on .*(\([0-9]*\) page' "$log" 2>/dev/null | grep -o '([0-9]*' | tr -d '(')
  undef=$(grep -ciE 'undefined (references|citations)|Citation .* undefined|Reference .* undefined' "$log" 2>/dev/null); warn=$(grep -c 'Warning' "$log" 2>/dev/null)
  if [ -n "$pages" ] && [ "$out/main.pdf" -nt "$d/main.tex" ]; then okl "build paper $pages pages undefined=$undef warnings=$warn pdf=$out/main.pdf"
  else fail "build paper failed: $(grep -m1 '^!' "$log" 2>/dev/null) -> see $log"; fi; }

cmd_env() { # snapshot rudra | snapshot cluster | fetch cluster RUN_ID  -> control/envs/<host>/
  local host=$2 dest="$CTRL/envs/$2" n
  case "$1 $host" in
    "snapshot rudra") mkdir -p "$dest"; remote rudra env-snapshot | tar -C "$dest" -xf - || { fail "env rudra snapshot failed"; return 1; }
       n=$(ls "$dest"/*.yml 2>/dev/null | wc -l | tr -d ' '); [ -s "$dest/system.txt" ] && okl "env rudra $n envs -> control/envs/rudra (mtd save $PROJECT_REPO \"env snapshot rudra\" control/envs/rudra)" || fail "env rudra wrote nothing";;
    "snapshot cluster") need_conf CLUSTER_WORK_ROOT
       local rs="$CLUSTER_WORK_ROOT/mdops-state/bin/mdops-remote.sh" CLUSTER_MIN_FREE_GB=2   # kilobytes of output; never blocked by the floor
       rssh cluster "mkdir -p $(q "$CLUSTER_WORK_ROOT/mdops-state/bin") && cat > $(q "$rs")" < "$REMOTE" || { fail "env cannot copy helper to cluster"; return 1; }
       local o rid; o=$( (cmd_run cluster --job job:env-snapshot --dir "$CLUSTER_WORK_ROOT" --allow-dirty --no-gpu --time 00:20:00 --mem 4G --cpus 2 -- \
         bash -c "mkdir -p \$MD_OUT_DIR/envs && MD_STATE=$(q "$CLUSTER_WORK_ROOT/mdops-state") bash $(q "$rs") env-snapshot | tar -C \$MD_OUT_DIR/envs -xf -") 2>&1)
       rid=$(printf '%s\n' "$o" | sed -n 's/^RUN //p')
       if [ -n "$rid" ]; then okl "env cluster snapshot job $rid queued (when it finishes: mtd env fetch cluster $rid)"
       else fail "env cluster snapshot not queued: $(printf '%s\n' "$o" | grep -v '^\[' | tail -1) -> fix, then: mtd env snapshot cluster"; fi;;
    "fetch cluster") need_conf CLUSTER_WORK_ROOT; [ -n "$3" ] || die "mtd env fetch cluster RUN_ID"; mkdir -p "$dest"
       rssh cluster "tar -C $(q "$CLUSTER_WORK_ROOT/runs/$3/envs") -cf - ." | tar -C "$dest" -xf - && okl "env cluster fetched -> control/envs/cluster" || fail "env fetch failed (job finished? mtd status $3)";;
    *) die "mtd env snapshot rudra|cluster | mtd env fetch cluster RUN_ID";;
  esac; }

cmd_ledger() { # verify: every valid result's run id exists in a run index
  [ "$1" = verify ] || die "mtd ledger verify"; local f="$CTRL/registry/results.yaml" ids miss=0 n=0 id h
  ids=$(awk '/^- id:/{v=0} /^  status: valid/{v=1} /^  run_id:/{r=$2} /^- id:|^$/{if(v&&r)print r; r=""} END{if(v&&r)print r}' "$f" | sort -u)
  for id in $ids; do n=$((n+1)); case "$id" in *-cluster-*) h=cluster;; *) h=rudra;; esac
    remote_ro "$h" run-status "$id" >/dev/null 2>&1 || { echo "  missing run $id on $h"; miss=$((miss+1)); }; done
  [ $miss = 0 ] && okl "ledger $n valid results, all runs found" || fail "ledger $miss of $n run ids not found -> fix results.yaml"; }

cmd_ask() { # "what — why" | --list [--all] | --close N "resolution"
  case "$1" in
    --list) remote_ro "$(hub)" ask-list "$2" 2>/dev/null || cat "$STATE/asks-offline.tsv" 2>/dev/null ;;
    --close) [ "$AGENT" = human ] || die "only the PI closes asks"; remote "$(hub)" ask-close "$2" "$3" ;;
    ""|-h) die 'mtd ask "<what you cannot access> — <why you need it>"' ;;
    *) remote "$(hub)" ask-add "$AGENT" "$*" 2>/dev/null || { printf '%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$AGENT" "$*" >> "$STATE/asks-offline.tsv"; okl "ask saved offline in state/asks-offline.tsv (hub $(hub) unreachable; tell the PI in chat)"; }
       echo "NOTE now ask the PI in chat as well; do not work around the missing access" ;;
  esac; }

cmd_resources() { # everything currently in use, compactly
  local g j
  g=$(rssh_ro rudra 'printf "gpu=%s " "$(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | awk -F", " "{printf \"%s%%,%s/%sMiB\", \$1,\$2,\$3}")"; printf "md-runs=%s " "$(tmux ls 2>/dev/null | grep -c "^md-")"; printf "home=%s used" "$(df -h ~ | awk "NR==2{print \$5}")"' 2>/dev/null)
  [ -n "$g" ] && echo "rudra   ${g/gpu= /gpu=none }" || echo "rudra   unreachable"
  j=$(rssh_ro cluster 'squeue -u $USER -h -o "%T" 2>/dev/null | sort | uniq -c | tr "\n" " "' 2>/dev/null)
  echo "cluster jobs: ${j:-none}  storage: $( [ -n "$CLUSTER_WORK_ROOT" ] && remote_ro cluster usage "$CLUSTER_WORK_ROOT" 2>/dev/null || echo 'work root unset')"
  echo "hub:     $(hub) (locks, journal, handoff, asks)"
  echo "locks:   $(remote_ro "$(hub)" lock list 2>/dev/null | tr '\n' ';' | sed 's/;$//')"
  echo "asks:    $(remote_ro "$(hub)" ask-list 2>/dev/null | grep -c '^#') open"
  echo "routes:  rudra=$(route rudra || echo DOWN) cluster=$(route cluster || echo DOWN)"; }


pubkey() { ls "$HOME"/.ssh/id_ed25519.pub "$HOME"/.ssh/id_rsa.pub "$HOME"/.ssh/id_ecdsa.pub 2>/dev/null | head -1; }
cmd_setup() { # finish or repair the installation; PI at a terminal only. Works with or without rudra.
  [ "$AGENT" = human ] && [ -t 0 ] || die "mtd setup is for the PI at a terminal"
  local rc=0 out ans rud=1 k; k=$(pubkey); k=${k:-~/.ssh/id_ed25519.pub}
  [ -f "$CTRL/mdops.conf" ] && cmd_profile apply "$CTRL/mdops.conf" >/dev/null && . "$CONF" && okl "setup project profile applied (work root ${CLUSTER_WORK_ROOT:-unset}, floor ${CLUSTER_MIN_FREE_GB}G free)"
  route cluster >/dev/null || { fail "setup cluster unreachable -> run: ssh-copy-id -f -i $k anu   (or: mtd login cluster), then: mtd setup"; return 1; }
  if ! route rudra >/dev/null; then rud=0
    fail "setup rudra: key login not working -> when rudra is on: ssh-copy-id -f -i $k rudra   (type rudra's password once), then: mtd setup"
    if [ "$(hub)" = rudra ]; then printf 'Carry on without rudra for now (cluster-only mode; back with: mtd hub use rudra)? [Y/n] '; read -r ans </dev/tty
      case "$ans" in n|N|no) return 1;; esac; cmd_hub use cluster || return 1; fi
  fi
  okl "setup routes rudra=$([ $rud = 1 ] && route rudra || echo offline) cluster=$(route cluster) hub=$(hub)"
  if [ -n "$CLUSTER_WORK_ROOT" ]; then
    rssh cluster "cd $(q "$CLUSTER_GROUP_ROOT") 2>/dev/null; mkdir -p $(q "$CLUSTER_WORK_ROOT")/stage $(q "$CLUSTER_WORK_ROOT")/runs $(q "$CLUSTER_WORK_ROOT")/cache $(q "$CLUSTER_WORK_ROOT")/tmp $(q "$CLUSTER_WORK_ROOT")/mdops-state" \
      && okl "setup cluster work root $CLUSTER_WORK_ROOT: $(remote cluster usage "$CLUSTER_WORK_ROOT")" || { fail "setup cannot create $CLUSTER_WORK_ROOT"; rc=1; }
  else fail "setup CLUSTER_WORK_ROOT unset -> set it in $CONF (docs/storage.md)"; rc=1; fi
  out="$STATE/discovery/$(date +%Y%m%d-%H%M%S)-setup"; mkdir -p "$out"
  if [ $rud = 1 ]; then
    rssh rudra "env MD_ROLE=rudra MD_PEER_HOST=$(q "$CLUSTER_HOST") MD_PEER_USER=$(q "$CLUSTER_USER") bash -s" < "$ROOT/remote/probe.sh" > "$out/rudra.txt" 2>&1 && okl "setup rudra scanned ($(wc -l < "$out/rudra.txt" | tr -d ' ') lines)" || { fail "setup rudra scan failed (see $out/rudra.txt)"; rc=1; }
    ln -sfn "$out" "$STATE/discovery/latest"
  fi
  cmd_agent_key init >/dev/null; APPROVED="PI ran mtd setup $(date '+%F %T')"
  ( c_grn=; c_yel=; c_red=; c_dim=; c_off=; cmd_agent_key authorize --yes ) 2>&1 | sed -E -n 's/^(PASS|OK) +/OK setup /p; s/^WARN/WARN setup/p'
  if [ $rud = 1 ]; then rssh rudra 'ssh -n -o BatchMode=yes -o ConnectTimeout=8 md-cluster true' >/dev/null 2>&1 && okl "setup rudra->cluster key already works" || { cmd_link_rudra_cluster --yes >/dev/null 2>&1 && okl "setup rudra->cluster key installed" || { fail "setup rudra->cluster key (cluster may refuse keys from rudra)"; rc=1; }; }; fi
  ho_fetch >/dev/null 2>&1; case $? in
    2) if cmd_handoff init >/dev/null 2>&1; then okl "setup handoff created on hub $(hub)"; else fail "setup handoff init"; rc=1; fi;;
    0) okl "setup handoff present on hub $(hub)";; *) fail "setup handoff unreachable on hub $(hub)"; rc=1;; esac
  [ $rud = 1 ] && cmd_env snapshot rudra | head -1
  [ -n "$CLUSTER_WORK_ROOT" ] && cmd_env snapshot cluster 2>&1 | grep -E '^(OK|FAIL|NOTE)' | head -2
  sync_cluster || true
  if [ "$(uname)" = Darwin ]; then cmd_awake on; cmd_keepalive install | sed 's/^PASS/OK/'; fi
  if [ "$BACKUP_STANDING_APPROVAL" != yes ]; then printf 'Backups to GitHub (+ rudra when up) are OFF. Allow agents to back up code and documents (never data) automatically? [y/N] '; read -r ans </dev/tty
    case "$ans" in y|Y|yes) sed -i.bak 's/^BACKUP_STANDING_APPROVAL=.*/BACKUP_STANDING_APPROVAL=yes/' "$CONF" && rm -f "$CONF.bak" && cmd_journal "PI set BACKUP_STANDING_APPROVAL=yes (mtd setup)" >/dev/null && okl "setup backups on";; *) okl "setup backups stay off (agents ask before each push)";; esac; fi
  cmd_check || rc=1; return $rc; }


cmd_awake() { # on|off|status: keep this Mac from idle/system sleep (caffeinate as a LaunchAgent). Lid-closed sleep still needs power + external display.
  local plist="$HOME/Library/LaunchAgents/au.anu.mdops.awake.plist"
  [ "$(uname)" = Darwin ] || die "awake is for the Mac (rudra: mtd harden-rudra)"
  case "${1:-status}" in
    on) mkdir -p "$HOME/Library/LaunchAgents"; cat > "$plist" <<EOF4
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>au.anu.mdops.awake</string>
  <key>ProgramArguments</key><array><string>/usr/bin/caffeinate</string><string>-i</string><string>-s</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
</dict></plist>
EOF4
       launchctl unload "$plist" 2>/dev/null; launchctl load -w "$plist" && okl "awake on: no idle/system sleep (display may still sleep; closing the lid sleeps unless on power with an external display)";;
    off) launchctl unload -w "$plist" 2>/dev/null; rm -f "$plist"; okl "awake off";;
    *) pgrep -fq 'caffeinate -i -s' && okl "awake on" || echo "WARN awake off (mtd awake on)";;
  esac; }


cmd_hub() { # status | use cluster|rudra : where coordination state lives; the project works with or without rudra
  case "${1:-status}" in
    status) local h; h=$(hub); route "$h" >/dev/null && okl "hub $h reachable (state $(hub_state_for "$h"))" || fail "hub $h unreachable -> mtd hub use $([ "$h" = rudra ] && echo cluster || echo rudra)";;
    use) local to=$2 from unreach=; from=$(hub); case "$to" in cluster|rudra) ;; *) die "mtd hub use cluster|rudra";; esac
      [ "$to" = "$from" ] && { okl "hub already $to"; return 0; }
      [ "$to" = cluster ] && need_conf CLUSTER_WORK_ROOT
      route "$to" >/dev/null || die "$to is unreachable too: mtd doctor"
      local fsp tsp; fsp=$(hub_state_for "$from"); tsp=$(hub_state_for "$to")
      if route "$from" >/dev/null; then
        # merge, never overwrite: journal + asks are unioned; the destination's older handoff history is kept as handoff.before-<ts>
        local merge='set -e; cd "$1"; rm -rf .incoming; mkdir .incoming; tar -C .incoming -xf -
          for f in journal.md requests.tsv; do [ -f ".incoming/$f" ] || continue; cat "$f" ".incoming/$f" 2>/dev/null | awk '"'"'!seen[$0]++'"'"' > ".$f.m"; mv ".$f.m" "$f"; done
          if [ -d .incoming/handoff ]; then [ -d handoff ] && mv handoff "handoff.before-$(date +%Y%m%d-%H%M%S)"; mv .incoming/handoff handoff; fi; rm -rf .incoming'
        rssh "$from" "cd $fsp 2>/dev/null && tar -cf - \$(ls -d handoff journal.md requests.tsv 2>/dev/null)" | rssh "$to" "mkdir -p $tsp && bash -c $(q "$merge") _ $tsp" \
          && okl "hub state merged $from -> $to (older handoff history on $to kept)" || { fail "hub copy failed; nothing switched"; return 1; }
      else unreach=1; echo "NOTE $from unreachable: $to is seeded from the project repo's handoff mirror and the offline journal"; fi
      if grep -q '^MD_HUB=' "$CONF"; then sed -i.bak "s/^MD_HUB=.*/MD_HUB=$to/" "$CONF" && rm -f "$CONF.bak"; else printf '\nMD_HUB=%s\n' "$to" >> "$CONF"; fi
      MD_HUB=$to
      ho_fetch >/dev/null 2>&1; case $? in
        2) cmd_handoff init >/dev/null 2>&1 && okl "hub handoff seeded on $to from control/handoff";;
        0) # an older handoff from a previous outage may sit on $to: the mirror on this Mac is the newest copy
           if [ -n "$unreach" ] && [ -f "$CTRL/handoff/HANDOFF.md" ] && ! cmp -s "$CTRL/handoff/HANDOFF.md" "$HOFF/HANDOFF.md"; then
             cp "$CTRL/handoff/HANDOFF.md" "$HOFF/.new" && ho_put "$(awk '{print $1}' "$HOFF/.base")" "re-seeded from the project mirror ($from offline at hub move)" "$HOFF/.new" >/dev/null \
               && rm -f "$HOFF/.new" && ho_fetch >/dev/null 2>&1 && okl "hub handoff on $to brought up to date from control/handoff (older versions kept)"; fi;;
      esac
      [ -s "$STATE/journal-offline.md" ] && rssh "$to" "mkdir -p $tsp && cat >> $tsp/journal.md" < "$STATE/journal-offline.md" && mv "$STATE/journal-offline.md" "$STATE/journal-offline.merged.$(date +%s)"
      cmd_journal "coordination hub moved $from -> $to" >/dev/null; okl "hub now $to (all agents on this Mac use it)";;
    *) die "mtd hub [status] | mtd hub use cluster|rudra";;
  esac; }

# ---------- discovery (read-only everywhere) ----------
ssh_g() { ssh -G "$1" 2>/dev/null | awk -v k="$2" '$1==k{ $1=""; sub(/^ /,""); print }'; }

cmd_discover() {
  local ts out rq cq rh ch ru cu rp cp rj cj rid cid tsline rts
  ts=$(date +%Y%m%d-%H%M%S); out="$STATE/discovery/$ts"; mkdir -p "$out"
  say "== MatterDoor discovery (read-only). Report -> $out"
  {
    echo "===== mac"; sw_vers 2>/dev/null; uname -m; df -h "$HOME" | tail -1
    echo "ssh: $(ssh -V 2>&1)"; echo "rsync: $(rsync --version 2>/dev/null | head -1)"
    for t in git tmux mosh python3 brew conda code claude codex; do printf '%-8s %s\n' "$t" "$(command -v $t || echo -)"; done
    echo "===== tailscale"; [ -n "$TS_BIN" ] && { to 10 "$TS_BIN" status 2>&1; to 25 "$TS_BIN" netcheck 2>&1 | head -25; } || echo "no tailscale cli"
    echo "===== globalprotect"; ls -d /Applications/GlobalProtect.app 2>/dev/null || echo "not installed"
    echo "===== ssh hosts in ~/.ssh/config (names + resolved endpoints only; no keys)"
    for f in "$HOME/.ssh/config" "$HOME"/.ssh/config.d/*; do [ -f "$f" ] && awk 'tolower($1)=="host"{for(i=2;i<=NF;i++) print $i}' "$f"; done | grep -v '[*?!]' | grep -v '^md-' | sort -u | while read -r hh; do
      printf '%-22s host=%s user=%s port=%s jump=%s id=%s\n' "$hh" "$(ssh_g "$hh" hostname)" "$(ssh_g "$hh" user)" "$(ssh_g "$hh" port)" "$(ssh_g "$hh" proxyjump)" "$(ssh_g "$hh" identityfile | head -1)"
    done
  } > "$out/mac.txt" 2>&1
  sed -n '/===== ssh hosts/,$p' "$out/mac.txt"
  tsline=$(grep -i rudra "$out/mac.txt" | grep -E '^100\.' | head -1)
  [ -n "$tsline" ] && say "Tailscale sees rudra: $tsline" || say "Tailscale: no device named rudra on your tailnet (yet)"

  rq=$(awk '{print $1}' < <(sed -n '/===== ssh hosts/,$p' "$out/mac.txt" | grep -i rudra) | head -1)
  printf 'SSH name (alias or user@host) that reaches rudra [%s]: ' "${rq:-none found}"; read -r rid </dev/tty; rid=${rid:-$rq}
  cq=$(sed -n '/===== ssh hosts/,$p' "$out/mac.txt" | grep -E 'host=[^ ]*(cecs\.anu\.edu\.au|cluster)' | grep -vi rudra | awk '{print $1}' | head -1)
  printf 'SSH name (alias or user@host) that reaches the cluster [%s]: ' "${cq:-none found}"; read -r cid </dev/tty; cid=${cid:-$cq}
  [ -n "$rid" ] && [ -n "$cid" ] || die "need both names; re-run mdops discover"
  case "$rid$cid" in *md-*) die "give your own aliases or user@host, not the generated md-* names";; esac

  rh=$(ssh_g "$rid" hostname); ru=$(ssh_g "$rid" user); rp=$(ssh_g "$rid" port); rj=$(ssh_g "$rid" proxyjump)
  ch=$(ssh_g "$cid" hostname); cu=$(ssh_g "$cid" user); cp=$(ssh_g "$cid" port); cj=$(ssh_g "$cid" proxyjump)
  rts=$(printf '%s' "$tsline" | awk '{print $1}')
  case "$rh" in 100.*) rts=${rts:-$rh};; esac
  say "rudra   -> $ru@$rh:$rp ${rj:+(jump $rj)} ${rts:+tailscale=$rts}"
  say "cluster -> $cu@$ch:$cp ${cj:+(jump $cj)}"

  local mux="-o ControlMaster=auto -o ControlPath=$HOME/.ssh/cm/%C -o ControlPersist=4h -o ServerAliveInterval=15 -o ConnectTimeout=15"
  mkdir -p "$HOME/.ssh/cm"; chmod 700 "$HOME/.ssh/cm"
  for _h in "$rid" "$cid"; do
    if ! to 25 ssh -n -o BatchMode=yes $mux "$_h" true >/dev/null 2>&1; then
      say "== $_h needs a password/OTP: type it at the prompt below (it is not shown); the login is then reused for 4h"
      # shellcheck disable=SC2086
      ssh -o ControlMaster=yes -o ControlPath="$HOME/.ssh/cm/%C" -o ControlPersist=4h -fN "$_h" </dev/tty || warn "login to $_h failed"
    fi
  done
  say "== probing rudra"
  # shellcheck disable=SC2086
  ssh $mux "$rid" "env MD_ROLE=rudra MD_PEER_HOST=$(q "$ch") MD_PEER_USER=$(q "$cu") bash -s" < "$ROOT/remote/probe.sh" > "$out/rudra.txt" 2>&1 \
    && ok "rudra probed ($(wc -l < "$out/rudra.txt") lines)" || bad "rudra probe failed — see $out/rudra.txt"
  say "== probing cluster"
  # shellcheck disable=SC2086
  if ssh $mux "$cid" "env MD_ROLE=cluster MD_PATTERNS=$(q "${MD_PATTERNS:-matterdoor rudra}") MD_PROJECT_ROOT=$(q "$CLUSTER_PROJECT_ROOT") bash -s" < "$ROOT/remote/probe.sh" > "$out/cluster.txt" 2>&1; then ok "cluster probed directly ($(wc -l < "$out/cluster.txt") lines)"
  elif ssh $mux -J "$rid" "$cid" "env MD_ROLE=cluster MD_PATTERNS=$(q "${MD_PATTERNS:-matterdoor rudra}") MD_PROJECT_ROOT=$(q "$CLUSTER_PROJECT_ROOT") bash -s" < "$ROOT/remote/probe.sh" > "$out/cluster.txt" 2>&1; then ok "cluster probed via rudra"
  else bad "cluster probe failed — see $out/cluster.txt"; fi

  if [ ! -f "$CONF" ] || [ "$1" = --regen ]; then
    [ -f "$CONF" ] && cp "$CONF" "$CONF.bak.$ts"
    local rids cids
    rids=$(ssh -G "$rid" | awk '$1=="identityfile"{print $2}' | while read -r f; do g=${f/#\~/$HOME}; [ -f "$g" ] && printf '%s ' "$f"; done)
    cids=$(ssh -G "$cid" | awk '$1=="identityfile"{print $2}' | while read -r f; do g=${f/#\~/$HOME}; [ -f "$g" ] && printf '%s ' "$f"; done)
    local lan=$rh; case "$rh" in 100.*) lan=;; esac
    cat > "$CONF" <<EOF
# MatterDoor portal config — generated by mdops discover $ts from your aliases '$rid' and '$cid'.
# Plain shell assignments. After editing run: mdops sshconfig && mdops doctor
RUDRA_USER=$(q "$ru")
RUDRA_TS_HOST=$(q "$rts")        # Tailscale IP of rudra (primary route); empty until rudra joins the tailnet
RUDRA_LAN_HOST=$(q "$lan")       # campus hostname/IP (fallback route: on campus or GlobalProtect)
RUDRA_PORT=$(q "${rp:-22}")
RUDRA_IDENTITIES=$(q "${rids% }")
CLUSTER_USER=$(q "$cu")
CLUSTER_HOST=$(q "$ch")
CLUSTER_PORT=$(q "${cp:-22}")
CLUSTER_IDENTITIES=$(q "${cids% }")
CLUSTER_ORIG_JUMP=$(q "$cj")     # jump host your original alias used, kept for md-cluster-direct

# ---- storage (set by the lead agent after reviewing discovery; empty = feature refuses to run)
RUDRA_DATA_ROOT=                # canonical MatterDoor data + harvested runs on rudra
RUDRA_ARCHIVE_ROOT=             # where mdops archive writes .tar.zst
CLUSTER_WORK_ROOT=              # the ONLY cluster area mdops writes to (stage/, runs/)
CLUSTER_GROUP_ROOT=             # shared group dir: read-mostly, never pruned by mdops
CLUSTER_QUOTA_WARN_PCT=95       # warn above this % used
CLUSTER_QUOTA_STOP_PCT=100      # refuse above this % (100 = off: on a shared volume the free-GB floor is the real gate)
CLUSTER_MIN_FREE_GB=40          # refuse cluster writes when less than this is free

# ---- slurm defaults (from discovery)
SLURM_PARTITION=                # GPU partition
SLURM_CPU_PARTITION=            # set from discovery sinfo if CPU jobs need a named partition
SLURM_ACCOUNT=
SLURM_QOS=
SLURM_GRES=                     # typed GRES only, e.g. gpu:3090:1 (untyped GPU requests are refused)

# ---- project profile (apply with: mdops profile apply <project>/ops/mdops.conf)
CLUSTER_PROJECT_ROOT=           # project git checkout on the cluster
CLUSTER_SUBMIT_GUARD=           # project GPU submit guard, relative to CLUSTER_PROJECT_ROOT
EOF
    if [ -f "$CONF.bak.$ts" ]; then # keep storage/slurm/project choices across --regen
      grep -E '^(RUDRA_DATA_ROOT|RUDRA_ARCHIVE_ROOT|CLUSTER_[A-Z_]*ROOT|CLUSTER_QUOTA_[A-Z_]*|CLUSTER_SUBMIT_GUARD|SLURM_[A-Z_]*)=[^ #]' "$CONF.bak.$ts" > "$STATE/keep.$ts" || true
      [ -s "$STATE/keep.$ts" ] && cmd_profile apply "$STATE/keep.$ts" >/dev/null && say "kept your storage/slurm/project settings from the previous config"
      rm -f "$STATE/keep.$ts"
    fi
    ok "wrote $CONF"; . "$CONF"; cmd_sshconfig
  else say "config exists; not overwritten (mdops discover --regen to rebuild it)"; fi
  { echo "# discovery $ts"; echo; for f in mac rudra cluster; do echo "- $f.txt: $(wc -l < "$out/$f.txt" 2>/dev/null) lines"; done; } > "$out/README.md"
  ln -sfn "$out" "$STATE/discovery/latest"
  say; say "Discovery saved to $out  (latest: state/discovery/latest)"
  say "Next: tell the lead agent 'discovery done' — it reviews the report and sets the storage plan."; }

# ---------- dispatch ----------
# pull a global --approved "..." out of the arguments
_a=(); while [ $# -gt 0 ]; do case "$1" in --approved) APPROVED=$2; shift 2;; -v) VERBOSE=1; shift;; *) _a+=("$1"); shift;; esac; done
set -- ${_a[@]+"${_a[@]}"}
c=${1:-help}; shift 2>/dev/null
case "$c" in
  help|-h|--help) cmd_help ;;
  discover) cmd_discover "$@" ;;  sshconfig) cmd_sshconfig ;;  doctor) cmd_doctor ;;
  net) cmd_net "$@" ;;  login) cmd_login "$@" ;;  route) cmd_route "$@" ;;
  ssh) cmd_ssh "$@" ;;  open) cmd_open "$@" ;;  tunnel) cmd_tunnel "$@" ;;
  lock) cmd_lock "$@" ;;  journal) cmd_journal "$@" ;;
  run) cmd_run "$@" ;;  cancel) cmd_cancel "$@" ;;  runs) cmd_runs "$@" ;;  status) cmd_status "$@" ;;
  hub) cmd_hub "$@" ;;  setup) cmd_setup ;;  awake) cmd_awake "$@" ;;  check) cmd_check ;;  sync) cmd_sync "$@" ;;  save) cmd_save "$@" ;;  push) cmd_push "$@" ;;  backup) cmd_backup "$@" ;;
  build) cmd_build "$@" ;;  env) cmd_env "$@" ;;  ledger) cmd_ledger "$@" ;;  ask) cmd_ask "$@" ;;  resources) cmd_resources ;;
  profile) cmd_profile "$@" ;;  brief) cmd_brief "$@" ;;  handoff) cmd_handoff "$@" ;;  agent) cmd_agent "$@" ;;
  agent-key) cmd_agent_key "$@" ;;
  submit) cmd_submit "$@" ;;  census) cmd_census "$@" ;;  keepalive) cmd_keepalive "$@" ;;
  quota) cmd_quota ;;  stage) cmd_stage "$@" ;;  harvest) cmd_harvest "$@" ;;  prune) cmd_prune "$@" ;;
  link-rudra-cluster) cmd_link_rudra_cluster "$@" ;;  harden-rudra) cmd_harden_rudra "$@" ;;
  clean) cmd_clean "$@" ;;  archive) cmd_archive "$@" ;;
  version) git -C "$ROOT" log -1 --format='%h %cs' 2>/dev/null || echo unversioned ;;
  *) die "unknown command '$c' — mdops help" ;;
esac
